# FAIRINO España · web estática (Astro) en un hosting Apache (Dinahosting).
# Solo hay archivos HTML, CSS, JS, imágenes y vídeos: nada de PHP ni base de datos.
# El paso de http a https lo hace el propio hosting (actívalo en el panel si hiciera falta).

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# Sin www: www.fairino.es → fairino.es (y igual en la copia de fairinocobot.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Entradas del blog de la web anterior de fairino.es (WordPress) que no tienen página igual en esta: a la más parecida.
# El resto de direcciones de aquella web (/productos/fr5/, /contacto/, /descargas/…) existen igual aquí.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/robotica-humanoide-en-la-industria-el-siguiente-salto-en-automatizacion-inteligente/?$ /aplicaciones/soluciones/robot-humanoide/
  RedirectMatch 301 ^/catalogo-fairino-2026-robotica-colaborativa-para-la-industria/?$ /descargas/
  RedirectMatch 301 ^/camaras-3d-en-la-automatizacion-industrial-la-vision-inteligente-que-impulsa-la-robotica-colaborativa/?$ /productos/orbbec-gemini-2/
  # Productos retirados de la tienda (no son de la gama que vende FAIRINO España): sus direcciones llevan a Accesorios.
  RedirectMatch 301 ^/productos/(sensor-fuerza-par-inlux|mesa-desarrollo|plataforma-fijacion|pinza-a-medida|adaptador-antorcha|placa-montaje|pinza-vacio-area|mesa-fijacion|soporte-cobot-acero|adaptador-doble-herramienta)/?$ /accesorios/
</IfModule>

# Tipos de archivo que algunos servidores no conocen
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
</IfModule>

# Comprimir el texto (páginas, estilos, scripts)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché del navegador: las páginas se piden siempre de nuevo; imágenes, vídeos y letras se guardan un tiempo.
# Los archivos de _astro llevan su huella en el nombre y tienen su propia regla (_astro/.htaccess).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Solo por https durante un año (el navegador ya no intenta http).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Nadie puede meter la web dentro de otra página para engañar a los clientes (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # Sin cámara ni ubicación; el micrófono solo para el asistente de voz de la propia web.
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
</IfModule>

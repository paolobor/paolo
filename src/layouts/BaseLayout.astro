---
import '../styles/global.css';
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import plexFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AssistantWidget from '../components/AssistantWidget.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductLightbox from '../components/ProductLightbox.astro';
import IntroOverlay from '../components/IntroOverlay.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  overlayHeader?: boolean;
  noindex?: boolean;
  whatsappMessage?: string;
  jsonLd?: Record<string, unknown>[];
  lang?: 'es' | 'en';
  // Muestra la intro animada (public/intro) encima de la página la primera vez de la sesión.
  intro?: boolean;
}

const {
  title,
  description,
  image = 'og-default.png',
  overlayHeader = false,
  noindex = false,
  whatsappMessage,
  jsonLd = [],
  lang = 'es',
  intro = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Configuración que necesitan los scripts de cliente (formularios, WhatsApp, configurador).
const clientConfig = {
  whatsapp: site.whatsapp.number,
  forms: { endpoint: site.forms.endpoint, accessKey: site.forms.accessKey, fallbackEmail: site.forms.fallbackEmail },
  showPrices: site.showPrices,
  currency: site.currency,
  base: import.meta.env.BASE_URL,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-ES" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#070504" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@fairinocobots" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script type="application/json" id="site-config" set:html={JSON.stringify(clientConfig)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      intro && (
        <>
          {/* Intro: se ve si no se ha visto en esta sesión (o con ?intro); nunca a los buscadores. Tapa en negro desde el primer instante. */}
          <script is:inline>
            (function () {
              var seen = false;
              var force = false;
              try { seen = sessionStorage.getItem('fairino-intro-vista') === '1'; } catch (e) {}
              try { force = new URLSearchParams(location.search).has('intro'); } catch (e) {}
              var bot = /bot|crawl|spider|slurp|lighthouse|headless|preview/i.test(navigator.userAgent);
              if (force || (!seen && !bot)) document.documentElement.classList.add('fi-play');
            })();
          </script>
          <style is:inline>
            .fi-overlay{display:none}
            html.fi-play .fi-overlay{display:block;position:fixed;inset:0;z-index:2147483000;background:#000}
            html.fi-play .fi-overlay>*{visibility:hidden}
            html.fi-play,html.fi-play body{overflow:hidden}
          </style>
        </>
      )
    }
    {
      site.analytics.gaId && (
        <>
          {/* Google Analytics: plantillas inactivas que CookieBanner activa solo con el consentimiento de análisis. */}
          <script is:inline type="text/plain" data-consent="analytics" async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.gaId}`} />
          <script is:inline type="text/plain" data-consent="analytics" define:vars={{ gaId: site.analytics.gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-dvh">
    {intro && <IntroOverlay />}
    <Header overlay={overlayHeader} />
    <main id="contenido" class:list={[!overlayHeader && 'pt-16 lg:pt-[72px]']}>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton message={whatsappMessage} />
    <AssistantWidget />
    <CookieBanner />
    <CartDrawer />
    <ProductLightbox />

    <script>
      import '../scripts/reveal';
      import '../scripts/forms';
      import '../scripts/add-to-config';
      import '../scripts/bg-video';
      import '../scripts/fx';
      import '../scripts/teaser';
    </script>
  </body>
</html>

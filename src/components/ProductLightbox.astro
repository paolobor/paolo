---
// Visor de fotos de producto. Al pinchar en un elemento con data-lb-open="<id del producto>" se abren sus fotos en
// grande. «Siguiente» y «Anterior» pasan las fotos y, al acabar, siguen con el producto siguiente o anterior de la misma
// lista (el contenedor más cercano con data-lb-scope, o toda la página), también si es de otro apartado.
// En el disparador, opcional: data-lb-section (nombre del apartado). Botón de acción: si el disparador está en una
// opción del configurador, «Elegir»; si está en un contenedor data-lb-item con su botón data-add-cart, «Añadir al
// carrito». Al cerrar en otro producto se lanza «lb:land» desde su disparador, para que la página lo deje a la vista.
// Fotos: /fotos-productos.json (src/pages/fotos-productos.json.ts).
import Icon from './ui/Icon.astro';
import { includedText } from '../data/caja';
import { url } from '../lib/url';
---

<dialog class="lb" aria-labelledby="lb-name" data-lb data-src={url('fotos-productos.json')}>
  <div class="lb-shell">
    <header class="lb-top">
      <div class="grid min-w-0 gap-1">
        <p class="lb-kind"><span data-lb-kind></span><span class="lb-pos" data-lb-pos></span></p>
        <h2 id="lb-name" class="lb-name" data-lb-name></h2>
      </div>
      <button type="button" class="lb-x" aria-label="Cerrar las fotos" data-lb-close>
        <Icon name="x" size={20} />
      </button>
    </header>

    <div class="lb-stage" data-lb-stage>
      <figure class="lb-fig" data-lb-fig>
        <img class="lb-img" alt="" draggable="false" sizes="(min-width: 1024px) 70vw, 100vw" data-lb-img />
      </figure>
      <button type="button" class="lb-nav lb-prev" data-lb-prev>
        <Icon name="chevron-left" size={24} />
        <span class="lb-nav-txt" data-lb-prev-txt></span>
      </button>
      <button type="button" class="lb-nav lb-next" data-lb-next>
        <span class="lb-nav-txt" data-lb-next-txt></span>
        <Icon name="chevron-right" size={24} />
      </button>
      <p class="lb-count" data-lb-count hidden></p>
    </div>

    <div class="lb-thumbs" data-lb-thumbs></div>

    <footer class="lb-foot">
      <div class="grid gap-1">
        <p class="lb-price" data-lb-price></p>
        <p class="lb-inc" data-lb-inc hidden>
          <Icon name="check" size={13} strokeWidth={3} />
          {includedText()}
        </p>
      </div>
      <div class="lb-actions" data-lb-buy>
        <a class="btn btn-ghost btn-sm" data-lb-href>Ficha completa <Icon name="arrow-right" size={16} /></a>
        <button type="button" class="btn btn-primary btn-sm" data-lb-action hidden></button>
        <p class="lb-note" data-lb-note hidden></p>
      </div>
      <!-- Tras «Añadir al carrito» el visor sigue abierto: ver el carrito o seguir con el producto siguiente. -->
      <div class="lb-actions" data-lb-added hidden>
        <p class="lb-ok" role="status">
          <Icon name="check" size={15} strokeWidth={3} />
          Añadido al carrito
        </p>
        <button type="button" class="btn btn-ghost btn-sm" data-lb-cart>
          <Icon name="shopping-basket" size={16} />
          Ver carrito
        </button>
        <button type="button" class="btn btn-primary btn-sm" data-lb-continue>
          Seguir comprando
          <Icon name="arrow-right" size={16} />
        </button>
      </div>
    </footer>
  </div>
</dialog>

<style>
  .lb {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(ellipse at 50% 92%, rgb(255 106 19 / 0.2), transparent 55%),
      radial-gradient(circle at 50% 45%, #1a110c, #070504 72%);
    color: var(--color-text);
  }
  .lb::backdrop {
    background: rgb(0 0 0 / 0.7);
  }
  .lb[open] {
    animation: lb-in 0.25s var(--ease-out-soft);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    height: 100%;
  }
  .lb-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem 0.25rem;
  }
  .lb-kind {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-signal);
  }
  .lb-pos {
    color: var(--color-mist);
  }
  .lb-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    font-weight: 800;
    font-stretch: 120%;
    line-height: 1.05;
    color: #fff;
  }
  .lb-x {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    color: #fff;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .lb-x:hover {
    border-color: var(--color-signal);
    color: var(--color-signal);
  }
  .lb-stage {
    position: relative;
    min-height: 0;
    touch-action: pan-y;
    user-select: none;
  }
  /* La foto cabe siempre entera en el hueco, sea cual sea su tamaño. */
  .lb-fig {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0.5rem 5.5rem 2.5rem;
  }
  .lb-fig.from-next {
    animation: lb-from-next 0.35s var(--ease-out-soft);
  }
  .lb-fig.from-prev {
    animation: lb-from-prev 0.35s var(--ease-out-soft);
  }
  @keyframes lb-from-next {
    from {
      opacity: 0;
      transform: translateX(56px);
    }
  }
  @keyframes lb-from-prev {
    from {
      opacity: 0;
      transform: translateX(-56px);
    }
  }
  .lb-img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
    transition: opacity 0.25s;
  }
  .lb-img.is-loading {
    opacity: 0;
  }
  .lb-ill {
    position: absolute;
    right: 1.25rem;
    bottom: 0.6rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.65);
    padding: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.85);
  }
  .lb-nav {
    position: absolute;
    top: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 3.25rem;
    height: 3.25rem;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(12 9 7 / 0.72);
    padding: 0 0.85rem;
    color: #fff;
    transform: translateY(-50%);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s,
      opacity 0.2s;
  }
  .lb-prev {
    left: 1.25rem;
  }
  .lb-next {
    right: 1.25rem;
  }
  .lb-nav:hover:not(:disabled) {
    border-color: var(--color-signal);
    background: rgb(255 122 26 / 0.2);
  }
  .lb-nav:disabled {
    opacity: 0.22;
    cursor: default;
  }
  /* Al acabar las fotos, el botón dice a qué producto (o apartado) pasas, en naranja. */
  .lb-nav.is-jump {
    border-color: var(--color-signal);
    background: var(--color-signal);
    color: var(--color-ink);
    box-shadow: 0 12px 34px -12px rgb(255 106 19 / 0.8);
  }
  .lb-nav.is-jump:hover:not(:disabled) {
    background: var(--color-brand-hi);
    color: var(--color-ink);
  }
  .lb-nav-txt {
    max-width: 15rem;
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lb-nav-txt:empty {
    display: none;
  }
  .lb-count {
    position: absolute;
    bottom: 0.6rem;
    left: 50%;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    padding: 0.25rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-mist);
    transform: translateX(-50%);
  }
  .lb-thumbs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.4rem 1.25rem 0.6rem;
  }
  .lb-thumbs:empty {
    display: none;
  }
  .lb-thumbs :global(button) {
    flex-shrink: 0;
    width: 3.6rem;
    height: 3.6rem;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: radial-gradient(circle at 50% 40%, #1a110c, #0b0705 75%);
    padding: 0.25rem;
    opacity: 0.55;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }
  .lb-thumbs :global(button:hover) {
    opacity: 0.9;
  }
  .lb-thumbs :global(button[aria-current='true']) {
    border-color: var(--color-signal);
    opacity: 1;
  }
  .lb-thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .lb-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(11 7 5 / 0.88);
    padding: 0.9rem 1.25rem calc(0.9rem + env(safe-area-inset-bottom));
  }
  .lb-price {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: #fff;
  }
  .lb-inc {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-ok);
  }
  .lb-inc :global(svg) {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .lb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .lb-note {
    font-size: 0.82rem;
    color: #f3d98a;
  }
  .lb-ok {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    background: rgb(126 226 164 / 0.12);
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ok);
  }
  @media (max-width: 640px) {
    .lb-top {
      padding: 0.8rem 1rem 0.25rem;
    }
    .lb-fig {
      padding: 0.25rem 0.75rem 4.25rem;
    }
    .lb-nav {
      top: auto;
      bottom: 0.6rem;
      height: 2.9rem;
      min-width: 2.9rem;
      transform: none;
    }
    .lb-prev {
      left: 0.75rem;
    }
    .lb-next {
      right: 0.75rem;
    }
    /* Los dos botones caben a la vez aunque los dos digan a qué producto pasas. */
    .lb-nav-txt {
      max-width: calc(50vw - 5.25rem);
      font-size: 0.75rem;
    }
    /* Contador y aviso de imagen ilustrativa, arriba, para no chocar con los botones. */
    .lb-count {
      top: 0.25rem;
      bottom: auto;
      left: 1rem;
      transform: none;
    }
    .lb-ill {
      top: 0.25rem;
      right: 1rem;
      bottom: auto;
    }
    .lb-fig {
      padding-top: 2.25rem;
    }
    .lb-foot {
      padding-inline: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb[open],
    .lb-fig.from-next,
    .lb-fig.from-prev {
      animation: none;
    }
  }
</style>

<script>
  import { addToCart, chosenVersion } from '../scripts/cart';

  type Photo = { src: string; srcset: string; alt: string; ill: boolean };
  type Item = { name: string; kind: string; rank: number; href: string; price: string; box: boolean; photos: Photo[] };
  type Entry = { id: string; el: HTMLElement; section: string };

  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (dlg) {
    const $ = <T extends HTMLElement = HTMLElement>(k: string) => dlg.querySelector<T>(`[data-lb-${k}]`)!;
    const fig = $('fig');
    const img = $<HTMLImageElement>('img');
    const stage = $('stage');
    const prevBtn = $<HTMLButtonElement>('prev');
    const nextBtn = $<HTMLButtonElement>('next');
    const thumbs = $('thumbs');
    const actBtn = $<HTMLButtonElement>('action');
    const note = $('note');
    const buy = $('buy');
    const added = $('added');
    const contBtn = $<HTMLButtonElement>('continue');
    // Qué hacer después de cerrar (p. ej. abrir el carrito), cuando el visor ya ha devuelto la página a su sitio.
    let afterClose: (() => void) | null = null;

    let data: Record<string, Item> | null = null;
    let loading: Promise<Record<string, Item> | null> | null = null;
    const load = () =>
      (loading ??= fetch(dlg.dataset.src!)
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null)
        .then((d) => {
          data = d;
          if (!d) loading = null;
          return d;
        }));

    let list: Entry[] = [];
    let pos = 0;
    let photo = 0;
    let startId = '';
    let opener: HTMLElement | null = null;

    // Todos los productos con fotos de la lista del disparador, sin repetir y agrupados por apartado: en el orden de la
    // página si esta pone los apartados (data-lb-section) y, si no, en el de las pestañas de la tienda (Cobots,
    // Controladores, Accesorios FAIRINO, Pinzas eléctricas…), para no saltar de un tipo de producto a otro.
    const build = (trigger: HTMLElement) => {
      const scope = trigger.closest('[data-lb-scope]') ?? document;
      const seen = new Set<string>();
      const out: Entry[] = [];
      let own = false;
      scope.querySelectorAll<HTMLElement>('[data-lb-open]').forEach((el) => {
        const id = el.dataset.lbOpen!;
        if (!data?.[id]?.photos.length || seen.has(id)) return;
        seen.add(id);
        own ||= Boolean(el.dataset.lbSection);
        out.push({ id, el, section: el.dataset.lbSection || data[id].kind });
      });
      return own ? out : out.sort((a, b) => data![a.id].rank - data![b.id].rank);
    };

    const item = (e: Entry = list[pos]) => data![e.id];
    const firstSrc = (p: Photo) => p.srcset.split(',')[0]?.trim().split(' ')[0] || p.src;

    // Qué se puede hacer con el producto desde el visor.
    const actionOf = (e: Entry) => {
      const input = e.el.closest('label')?.querySelector<HTMLInputElement>('input');
      if (input) return { kind: 'pick' as const, input };
      const add = e.el.closest('[data-lb-item]')?.querySelector<HTMLElement>(`[data-add-cart="${e.id}"]`);
      if (add) return { kind: 'cart' as const, add };
      return null;
    };

    const renderFoot = () => {
      const e = list[pos];
      const it = item(e);
      $('price').textContent = it.price;
      $('inc').hidden = !it.box;
      $<HTMLAnchorElement>('href').href = it.href;
      buy.hidden = false;
      added.hidden = true;
      const a = actionOf(e);
      actBtn.hidden = !a;
      actBtn.disabled = false;
      note.hidden = true;
      if (a?.kind === 'pick') {
        const { input } = a;
        if (input.disabled) {
          actBtn.hidden = true;
          note.hidden = false;
          note.textContent = 'No compatible con el cobot elegido';
        } else if (input.type === 'radio') {
          actBtn.textContent = input.checked ? '✓ Elegido para tu célula' : 'Elegir para mi célula';
          actBtn.disabled = input.checked;
        } else {
          actBtn.textContent = input.checked ? '✓ En tu célula · Quitar' : 'Añadir a mi célula';
        }
      } else if (a?.kind === 'cart') {
        actBtn.textContent = 'Añadir al carrito';
      }
    };

    const renderThumbs = () => {
      const it = item();
      thumbs.innerHTML = '';
      if (it.photos.length < 2) return;
      it.photos.forEach((p, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', `Foto ${i + 1} de ${it.photos.length}`);
        const t = document.createElement('img');
        t.src = firstSrc(p);
        t.alt = '';
        t.loading = 'lazy';
        b.append(t);
        b.addEventListener('click', () => {
          photo = i;
          render(0);
        });
        thumbs.append(b);
      });
    };

    const preload = (p?: Photo) => {
      if (!p) return;
      const i = new Image();
      i.sizes = img.sizes;
      i.srcset = p.srcset;
      i.src = p.src;
    };

    const render = (dir: number) => {
      const e = list[pos];
      const it = item(e);
      const ph = it.photos[photo];
      if (dir) {
        fig.classList.remove('from-next', 'from-prev');
        void fig.offsetWidth;
        fig.classList.add(dir > 0 ? 'from-next' : 'from-prev');
        renderThumbs();
        renderFoot();
      }
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.srcset = ph.srcset;
      img.src = ph.src;
      img.alt = ph.alt || it.name;
      if (img.complete) img.classList.remove('is-loading');
      $('ill').hidden = !ph.ill;
      $('kind').textContent = e.section;
      // Posición dentro de su apartado: «3 de 24».
      const same = list.filter((x) => x.section === e.section);
      $('pos').textContent = same.length > 1 ? `${same.indexOf(e) + 1} de ${same.length}` : '';
      $('name').textContent = it.name;
      const count = $('count');
      count.hidden = it.photos.length < 2;
      count.textContent = `Foto ${photo + 1} de ${it.photos.length}`;
      thumbs.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i === photo)));

      // Botones: dentro de las fotos, flecha; en la última (o la primera), a qué producto o apartado pasas.
      const last = photo === it.photos.length - 1;
      const first = photo === 0;
      const next = list[pos + 1];
      const prev = list[pos - 1];
      const jump = (o: Entry | undefined, newSection: string, sameSection: string) =>
        !o ? '' : o.section !== e.section ? `${newSection}: ${o.section}` : `${sameSection}: ${data![o.id].name}`;
      $('next-txt').textContent = last ? jump(next, 'Siguiente apartado', 'Siguiente') : '';
      $('prev-txt').textContent = first ? jump(prev, 'Apartado anterior', 'Anterior') : '';
      nextBtn.disabled = last && !next;
      prevBtn.disabled = first && !prev;
      nextBtn.classList.toggle('is-jump', last && !!next);
      prevBtn.classList.toggle('is-jump', first && !!prev);
      nextBtn.setAttribute('aria-label', !last ? 'Foto siguiente' : next ? `Siguiente producto: ${data![next.id].name}` : 'No hay más productos');
      prevBtn.setAttribute('aria-label', !first ? 'Foto anterior' : prev ? `Producto anterior: ${data![prev.id].name}` : 'No hay productos antes');

      preload(last ? next && data![next.id].photos[0] : it.photos[photo + 1]);
    };

    const go = (dir: 1 | -1) => {
      const it = item();
      if (dir > 0) {
        if (photo < it.photos.length - 1) {
          photo++;
          render(0);
        } else if (pos < list.length - 1) {
          pos++;
          photo = 0;
          render(1);
        }
      } else if (photo > 0) {
        photo--;
        render(0);
      } else if (pos > 0) {
        pos--;
        photo = item().photos.length - 1;
        render(-1);
      }
    };

    const open = async (trigger: HTMLElement) => {
      const id = trigger.dataset.lbOpen!;
      const d = await load();
      if (!d?.[id]?.photos.length) return;
      list = build(trigger);
      pos = list.findIndex((x) => x.el === trigger);
      if (pos < 0) pos = Math.max(0, list.findIndex((x) => x.id === id));
      photo = 0;
      startId = id;
      opener = trigger;
      renderThumbs();
      renderFoot();
      render(0);
      document.documentElement.style.overflow = 'hidden';
      if (!dlg.open) dlg.showModal();
      (nextBtn.disabled ? $('close') : nextBtn).focus({ preventScroll: true });
    };

    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      const e = list[pos];
      const moved = e && e.id !== startId;
      // La página deja a la vista el producto en el que te has quedado (cambia de pestaña, de modelo…).
      if (moved) e.el.dispatchEvent(new CustomEvent('lb:land', { bubbles: true, detail: { id: e.id } }));
      requestAnimationFrame(() => {
        const target = moved ? e.el : opener;
        if (moved && e.el.getClientRects().length) {
          (e.el.closest<HTMLElement>('[data-lb-item], label, li') ?? e.el).scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
        if (afterClose) {
          const run = afterClose;
          afterClose = null;
          run();
        } else target?.focus({ preventScroll: true });
      });
    });

    $('close').addEventListener('click', () => dlg.close());
    $('cart').addEventListener('click', () => {
      afterClose = () => document.querySelector<HTMLElement>('[data-cart-open]')?.click();
      dlg.close();
    });
    // «Seguir comprando»: al producto siguiente de la lista; si era el último, se cierra el visor.
    contBtn.addEventListener('click', () => {
      if (pos < list.length - 1) {
        pos++;
        photo = 0;
        render(1);
        nextBtn.focus({ preventScroll: true });
      } else dlg.close();
    });
    prevBtn.addEventListener('click', () => go(-1));
    nextBtn.addEventListener('click', () => go(1));
    actBtn.addEventListener('click', () => {
      const a = actionOf(list[pos]);
      if (a?.kind === 'pick') {
        a.input.click();
        renderFoot();
        if (actBtn.disabled) nextBtn.focus({ preventScroll: true });
      } else if (a?.kind === 'cart') {
        // Mismo pedido que el botón de la página (versión y controladora AC/DC elegidas), sin salir del visor.
        const e = list[pos];
        addToCart(e.id, chosenVersion(e.id, a.add.dataset.version ?? '', a.add.dataset.power));
        const next = list[pos + 1];
        contBtn.setAttribute('aria-label', next ? `Seguir comprando: ver ${data![next.id].name}` : 'Seguir comprando');
        buy.hidden = true;
        added.hidden = false;
        contBtn.focus({ preventScroll: true });
      }
    });
    // En todo el documento: si el foco se sale del visor (p. ej. al desactivarse «Elegir»), las flechas siguen pasando.
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      }
    });

    // Deslizar con el dedo (o arrastrar con el ratón) para pasar; un clic fuera de la foto cierra.
    let sx = 0;
    let sy = 0;
    let swiped = false;
    stage.addEventListener('pointerdown', (e) => {
      sx = e.clientX;
      sy = e.clientY;
      swiped = false;
    });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) {
        swiped = true;
        go(dx < 0 ? 1 : -1);
      }
    });
    stage.addEventListener('click', (e) => {
      if (swiped) return;
      if (e.target === stage || e.target === fig) dlg.close();
    });

    document.addEventListener('click', (e) => {
      const t = (e.target as Element | null)?.closest?.<HTMLElement>('[data-lb-open]');
      if (!t) return;
      e.preventDefault();
      open(t);
    });
    // Las fotos se piden en cuanto el ratón o el dedo se acerca a un producto, para que el visor abra al momento.
    const warm = (e: Event) => {
      if ((e.target as Element | null)?.closest?.('[data-lb-open]')) load();
    };
    document.addEventListener('pointerover', warm, { passive: true });
    document.addEventListener('focusin', warm);
  }
</script>

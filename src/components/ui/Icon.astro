---
// Iconos lineales (Lucide, ISC) y de redes (Simple Icons, CC0) incrustados en el HTML: sin peticiones ni librerías en cliente.
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import award from 'lucide-static/icons/award.svg?raw';
import box from 'lucide-static/icons/box.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import chevronDown from 'lucide-static/icons/chevron-down.svg?raw';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import circleHelp from 'lucide-static/icons/circle-help.svg?raw';
import cpu from 'lucide-static/icons/cpu.svg?raw';
import download from 'lucide-static/icons/download.svg?raw';
import expand from 'lucide-static/icons/expand.svg?raw';
import factory from 'lucide-static/icons/factory.svg?raw';
import gitBranch from 'lucide-static/icons/git-branch.svg?raw';
import hand from 'lucide-static/icons/hand.svg?raw';
import info from 'lucide-static/icons/info.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import move from 'lucide-static/icons/move.svg?raw';
import pause from 'lucide-static/icons/pause.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import play from 'lucide-static/icons/play.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
import quote from 'lucide-static/icons/quote.svg?raw';
import refreshCw from 'lucide-static/icons/refresh-cw.svg?raw';
import scanEye from 'lucide-static/icons/scan-eye.svg?raw';
import send from 'lucide-static/icons/send.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import slidersHorizontal from 'lucide-static/icons/sliders-horizontal.svg?raw';
import timer from 'lucide-static/icons/timer.svg?raw';
import workflow from 'lucide-static/icons/workflow.svg?raw';
import wrench from 'lucide-static/icons/wrench.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import zap from 'lucide-static/icons/zap.svg?raw';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import newspaper from 'lucide-static/icons/newspaper.svg?raw';
import building2 from 'lucide-static/icons/building-2.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import graduationCap from 'lucide-static/icons/graduation-cap.svg?raw';
import headphones from 'lucide-static/icons/headphones.svg?raw';
import packageIcon from 'lucide-static/icons/package.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import externalLink from 'lucide-static/icons/external-link.svg?raw';
import car from 'lucide-static/icons/car.svg?raw';
import heartPulse from 'lucide-static/icons/heart-pulse.svg?raw';
import utensils from 'lucide-static/icons/utensils.svg?raw';
import shoppingBag from 'lucide-static/icons/shopping-bag.svg?raw';
import microchip from 'lucide-static/icons/microchip.svg?raw';
import hammer from 'lucide-static/icons/hammer.svg?raw';
import droplet from 'lucide-static/icons/droplet.svg?raw';
import pencilRuler from 'lucide-static/icons/pencil-ruler.svg?raw';
import handshake from 'lucide-static/icons/handshake.svg?raw';
import lifeBuoy from 'lucide-static/icons/life-buoy.svg?raw';
import calendarCheck from 'lucide-static/icons/calendar-check.svg?raw';
import scale from 'lucide-static/icons/scale.svg?raw';
import ruler from 'lucide-static/icons/ruler.svg?raw';
import siFacebook from 'simple-icons/icons/facebook.svg?raw';
import siInstagram from 'simple-icons/icons/instagram.svg?raw';
import siWhatsapp from 'simple-icons/icons/whatsapp.svg?raw';
import siX from 'simple-icons/icons/x.svg?raw';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  label?: string;
}

const { name, size = 24, class: className = '', strokeWidth = 1.6, label } = Astro.props;

const stroke: Record<string, string> = {
  'arrow-right': arrowRight, 'arrow-up-right': arrowUpRight, award, box, calendar, check,
  'chevron-down': chevronDown, 'chevron-left': chevronLeft, 'chevron-right': chevronRight,
  'circle-help': circleHelp, cpu, download, expand, factory, 'git-branch': gitBranch, hand, info,
  layers, mail, 'map-pin': mapPin, menu, move, pause, phone, play, plus, quote, 'refresh-cw': refreshCw,
  'scan-eye': scanEye, send, 'shield-check': shieldCheck, 'sliders-horizontal': slidersHorizontal,
  timer, workflow, wrench, x, zap,
  'file-text': fileText, 'newspaper': newspaper, 'building-2': building2, 'users': users, 'graduation-cap': graduationCap, 'headphones': headphones, 'package': packageIcon, 'clock': clock, 'external-link': externalLink, 'car': car, 'heart-pulse': heartPulse, 'utensils': utensils, 'shopping-bag': shoppingBag, 'microchip': microchip, 'hammer': hammer, 'droplet': droplet, 'pencil-ruler': pencilRuler, 'handshake': handshake, 'life-buoy': lifeBuoy, 'calendar-check': calendarCheck, 'scale': scale, 'ruler': ruler,
};
const brand: Record<string, string> = {
  facebook: siFacebook, instagram: siInstagram, whatsapp: siWhatsapp, x: siX,
  // LinkedIn no está en Simple Icons: glifo propio simplificado.
  linkedin:
    '<svg viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.6h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76v5.59h-4v-4.95c0-1.18-.02-2.7-1.75-2.7-1.76 0-2.03 1.3-2.03 2.62v5.03h-4v-11Z"/></svg>',
};

const inner = (svg: string) =>
  svg
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/^[\s\S]*?<svg[^>]*>/, '')
    .replace(/<\/svg>\s*$/, '')
    .replace(/<title>[\s\S]*?<\/title>/, '')
    .trim();

const isBrand = name.startsWith('si:');
const key = isBrand ? name.slice(3) : name;
const source = isBrand ? brand[key] : stroke[key];
if (!source) throw new Error(`Icono desconocido: ${name}`);
const body = inner(source);
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

{
  isBrand ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} {...a11y} set:html={body} />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      {...a11y}
      set:html={body}
    />
  )
}

---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { findImage, SCENE_WIDTHS } from '../../lib/images';

// Imagen optimizada (AVIF/WebP, srcset, carga diferida) o placeholder visible si aún no existe.
interface Props {
  src: string | ImageMetadata | null | undefined;
  alt: string;
  hint?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  tone?: 'light' | 'dark';
  kind?: 'FOTO' | 'RENDER';
  align?: 'center' | 'top';
  fit?: 'cover' | 'contain';
  // Encuadre al recortar (object-position), p. ej. '60% 50%'.
  position?: string;
  eager?: boolean;
}

const {
  src,
  alt,
  hint,
  widths = [480, 800, 1200, 1600],
  sizes = '100vw',
  class: className = '',
  tone = 'light',
  kind = 'FOTO',
  align = 'center',
  fit = 'cover',
  position,
  eager = false,
} = Astro.props;

const image = typeof src === 'string' || src == null ? findImage(src as string | null) : src;
// Escenas generadas: anchos fijos y solo WebP (ver SCENE_WIDTHS).
const scene = !!image && /fairino-[a-z0-9]+-escena-/.test(image.src);
const wanted = scene ? SCENE_WIDTHS : widths;
const validWidths = image ? wanted.filter((w) => w <= image.width).concat(wanted.some((w) => w > image.width) ? [image.width] : []) : [];
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      widths={validWidths}
      sizes={sizes}
      formats={scene ? ['webp'] : ['avif', 'webp']}
      fallbackFormat={scene ? 'webp' : undefined}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      pictureAttributes={{ class: 'block size-full' }}
      class:list={['size-full', fit === 'cover' ? 'object-cover' : 'object-contain', className]}
      style={position ? `object-position:${position}` : undefined}
    />
  ) : (
    <Placeholder label={hint ?? alt} tone={tone} kind={kind} align={align} class={className} />
  )
}

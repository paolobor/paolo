---
// Hueco para material pendiente (foto, vídeo, logo): un recuadro neutro con un icono de imagen; el nombre de lo que
// falta queda solo en el atributo data-pendiente, para encontrarlo al revisar la web.
interface Props {
  label: string;
  kind?: 'FOTO' | 'VÍDEO' | 'LOGO' | 'RENDER';
  tone?: 'light' | 'dark';
  // 'top': etiqueta arriba, para huecos con texto superpuesto abajo (tarjetas de aplicación).
  align?: 'center' | 'top';
  class?: string;
}
const { label, kind = 'FOTO', tone = 'light', align = 'center', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'ph relative grid h-full w-full justify-items-center overflow-hidden p-4 text-center font-mono leading-snug',
    align === 'top' ? 'content-start pt-6 text-[0.62rem] sm:text-[0.7rem]' : 'content-center text-[0.72rem]',
    tone === 'light' ? 'ph-light text-muted' : 'ph-dark text-mist',
    className,
  ]}
  role="img"
  aria-label={label}
  data-pendiente={`${kind}: ${label}`}
>
  <svg class="relative size-9 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m21 16-5-5-9 9" /></svg>
</div>

<style>
  .ph-light {
    background: var(--color-paper);

  }
  .ph-dark {
    background: #15100c;

  }
</style>

---
// Asistente virtual de FAIRINO España (ElevenLabs Agents): voz y chat de texto. Solo se pinta cuando hay agentId en
// src/data/site.ts. El script del widget se carga cuando la página ya está lista y el aviso de cookies contestado.
// El modo «voz + texto», la posición y el dominio permitido se configuran en el panel del agente (ver site.ts).
import { site } from '../data/site';

const agentId = site.assistant.agentId;
const host = new URL(site.url).hostname;
// Textos del widget en español (atributo text-contents; manda sobre los del panel). Va abajo a la izquierda porque
// abajo a la derecha está el botón de WhatsApp. El idioma no se fuerza desde aquí: lo pone el agente (español), y
// forzarlo sin permitirlo en Security → Overrides corta la conversación.
const textos = JSON.stringify({
  main_label: '¿Dudas con los cobots?',
  start_call: 'Hablar',
  start_chat: 'Escribir',
  new_call: 'Nueva llamada',
  end_call: 'Colgar',
  mute_microphone: 'Silenciar micrófono',
  change_language: 'Cambiar idioma',
  collapse: 'Cerrar',
  expand: 'Abrir el chat',
  copied: 'Copiado',
  accept_terms: 'Aceptar',
  dismiss_terms: 'Cancelar',
  listening_status: 'Te escucho…',
  speaking_status: 'Hablando…',
  connecting_status: 'Conectando…',
  chatting_status: 'En el chat',
  input_label: 'Mensaje',
  input_placeholder: 'Escribe tu pregunta…',
  input_placeholder_text_only: 'Escribe tu pregunta…',
  input_placeholder_new_conversation: 'Escribe para empezar…',
  user_ended_conversation: 'Has terminado la conversación',
  agent_ended_conversation: 'El asistente ha terminado la conversación',
  error_occurred: 'Ha habido un error. Vuelve a intentarlo.',
  send_message: 'Enviar',
  text_mode: 'Texto',
  voice_mode: 'Voz',
  switched_to_text_mode: 'Ahora por texto',
  switched_to_voice_mode: 'Ahora por voz',
  copy: 'Copiar',
  typing_indicator: 'Escribiendo…',
});
---

{
  agentId && (
    <>
      <elevenlabs-convai
        agent-id={agentId}
        placement="bottom-left"
        avatar-orb-color-1="#ff7a1a"
        avatar-orb-color-2="#ffe2c8"
        text-contents={textos}
        markdown-link-allowed-hosts={host}
      />
      <script is:inline>
        // El widget va en la misma esquina que el aviso de cookies: no se carga hasta que el visitante contesta al aviso,
        // y se esconde si lo vuelve a abrir desde el pie de página. Se carga 1,5 s después de la página.
        (function () {
          var el = document.querySelector('elevenlabs-convai');
          // En el móvil, solo el botón redondo: la tarjeta completa tapa el contenido.
          if (window.matchMedia('(max-width: 639px)').matches) el.setAttribute('variant', 'tiny');
          var load = function () {
            var s = document.createElement('script');
            s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed';
            s.async = true;
            s.type = 'text/javascript';
            document.body.appendChild(s);
          };
          var start = function () {
            var banner = document.getElementById('cookie-banner');
            if (banner) {
              var sync = function () {
                el.style.display = banner.hidden ? '' : 'none';
              };
              sync();
              new MutationObserver(sync).observe(banner, { attributes: true, attributeFilter: ['hidden'] });
            }
            if (banner && !banner.hidden) window.addEventListener('consent:change', function () { setTimeout(load, 300); }, { once: true });
            else setTimeout(load, 1500);
          };
          if (document.readyState === 'complete') start();
          else window.addEventListener('load', start);
        })();
      </script>
    </>
  )
}

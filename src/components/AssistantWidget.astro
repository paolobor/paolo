---
// Asistente virtual de FAIRINO España (ElevenLabs Agents): voz y chat de texto. Solo se pinta cuando hay agentId en
// src/data/site.ts. El script del widget se carga cuando la página ya está lista, para no retrasar la carga.
// El modo «voz + texto», la posición y el dominio permitido se configuran en el panel del agente (ver site.ts).
import { site } from '../data/site';

const agentId = site.assistant.agentId;
const host = new URL(site.url).hostname;
---

{
  agentId && (
    <>
      <elevenlabs-convai
        agent-id={agentId}
        override-language="es"
        avatar-orb-color-1="#ff7a1a"
        avatar-orb-color-2="#ffe2c8"
        action-text="¿Dudas con los cobots?"
        start-call-text="Hablar"
        end-call-text="Colgar"
        expand-text="Abrir el chat"
        listening-text="Te escucho…"
        speaking-text="Hablando…"
        markdown-link-allowed-hosts={host}
      />
      <script is:inline>
        (function () {
          var load = function () {
            var s = document.createElement('script');
            s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed';
            s.async = true;
            s.type = 'text/javascript';
            document.body.appendChild(s);
          };
          if (document.readyState === 'complete') setTimeout(load, 1500);
          else window.addEventListener('load', function () { setTimeout(load, 1500); });
        })();
      </script>
    </>
  )
}

---
// Asistente virtual de FAIRINO España (ElevenLabs Agents): voz y chat de texto. Solo se pinta cuando hay agentId en
// src/data/site.ts. El script del widget se carga cuando la página ya está lista y el aviso de cookies contestado.
// El modo «voz + texto», la posición y el dominio permitido se configuran en el panel del agente (ver site.ts).
// persistent-session: las conversaciones escritas siguen al cerrar el chat, cambiar de página o recargar (el widget guarda
// un token en el almacenamiento local y ElevenLabs le devuelve el historial). Las de voz terminan al cerrar, como siempre.
import { site } from '../data/site';
import { url } from '../lib/url';
import { assistantLinkHosts } from '../lib/assistant-hosts';

const agentId = site.assistant.agentId;
// Enlaces que el asistente puede poner como clicables (ver lib/assistant-hosts.ts). Las imágenes se ven de cualquier sitio.
const hosts = (await assistantLinkHosts()).join(',');
const limit = site.assistant.dailyLimit;
const contacto = url('contacto/');
// Textos del widget en español (atributo text-contents; manda sobre los del panel). Va abajo a la izquierda porque
// abajo a la derecha está el botón de WhatsApp. El idioma no se fuerza desde aquí: lo pone el agente (español), y
// forzarlo sin permitirlo en Security → Overrides corta la conversación.
const textos = JSON.stringify({
  main_label: '¿Dudas con los cobots?',
  start_call: 'Hablar',
  start_chat: 'Escribir',
  new_call: 'Nueva llamada',
  end_call: 'Colgar',
  mute_microphone: 'Silenciar micrófono',
  change_language: 'Cambiar idioma',
  collapse: 'Cerrar',
  expand: 'Abrir el chat',
  copied: 'Copiado',
  accept_terms: 'Aceptar',
  dismiss_terms: 'Cancelar',
  listening_status: 'Te escucho…',
  speaking_status: 'Hablando…',
  connecting_status: 'Conectando…',
  chatting_status: 'En el chat',
  input_label: 'Mensaje',
  input_placeholder: 'Escribe tu pregunta…',
  input_placeholder_text_only: 'Escribe tu pregunta…',
  input_placeholder_new_conversation: 'Escribe para empezar…',
  user_ended_conversation: 'Has terminado la conversación',
  agent_ended_conversation: 'El asistente ha terminado la conversación',
  error_occurred: 'Ha habido un error. Vuelve a intentarlo.',
  send_message: 'Enviar',
  text_mode: 'Texto',
  voice_mode: 'Voz',
  switched_to_text_mode: 'Ahora por texto',
  switched_to_voice_mode: 'Ahora por voz',
  copy: 'Copiar',
  typing_indicator: 'Escribiendo…',
});
---

{
  agentId && (
    <>
      <elevenlabs-convai
        agent-id={agentId}
        placement="bottom-left"
        avatar-orb-color-1="#ff7a1a"
        avatar-orb-color-2="#ffe2c8"
        text-contents={textos}
        markdown-link-allowed-hosts={hosts}
        persistent-session="true"
        data-limite={limit}
        data-contacto={contacto}
      />
      <script is:inline>
        // El widget va en la misma esquina que el aviso de cookies: no se carga hasta que el visitante contesta al aviso,
        // y se esconde si lo vuelve a abrir desde el pie de página. Se carga 1,5 s después de la página.
        (function () {
          var el = document.querySelector('elevenlabs-convai');
          // Tope de conversaciones por visitante y día (site.assistant.dailyLimit), contado en este navegador. Cada
          // conversación nueva, de voz o de texto, lanza «elevenlabs-convai:call» antes de conectar; las que solo
          // retoman una de texto al cambiar de página llevan persistentSession.token y no cuentan. Al pasarse, se le da
          // al widget un agente que no existe para que no llegue a conectar (no gasta créditos) y se cambia por un aviso.
          var LIMIT = Number(el.dataset.limite) || 0;
          var KEY = 'fairino-asistente';
          var hoy = function () {
            var d = new Date();
            return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
          };
          var usadas = function () {
            try {
              var v = JSON.parse(localStorage.getItem(KEY) || 'null');
              return v && v.d === hoy() ? v.n : 0;
            } catch (e) {
              return 0;
            }
          };
          var aviso = function () {
            var a = document.createElement('div');
            a.className = 'fi-asistente-aviso';
            a.setAttribute('role', 'status');
            a.innerHTML =
              '<p>Has usado las ' + LIMIT + ' conversaciones de hoy con el asistente. Mañana puedes volver a hablar con él o, si lo necesitas ya, ' +
              '<a href="' + el.dataset.contacto + '">escríbenos</a>.</p><button type="button" aria-label="Cerrar">×</button>';
            a.querySelector('button').addEventListener('click', function () { a.remove(); });
            document.body.appendChild(a);
          };
          if (LIMIT && usadas() >= LIMIT) {
            el.remove();
            // Ya gastadas hoy: se avisa una vez por visita (si no, parecía que el asistente había desaparecido).
            try {
              if (!sessionStorage.getItem('fairino-asistente-aviso')) {
                sessionStorage.setItem('fairino-asistente-aviso', '1');
                aviso();
              }
            } catch (e) {}
            return;
          }
          if (LIMIT) {
            el.addEventListener('elevenlabs-convai:call', function (e) {
              var c = e.detail && e.detail.config;
              if (!c || (c.persistentSession && c.persistentSession.token)) return;
              var n = usadas() + 1;
              try {
                localStorage.setItem(KEY, JSON.stringify({ d: hoy(), n: n }));
              } catch (err) {}
              if (n <= LIMIT) return;
              c.agentId = 'limite-diario';
              delete c.signedUrl;
              setTimeout(function () {
                el.remove();
                aviso();
              }, 0);
            });
          }
          // En el móvil, solo el botón redondo: la tarjeta completa tapa el contenido.
          if (window.matchMedia('(max-width: 639px)').matches) el.setAttribute('variant', 'tiny');
          var load = function () {
            var s = document.createElement('script');
            s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed';
            s.async = true;
            s.type = 'text/javascript';
            document.body.appendChild(s);
          };
          var start = function () {
            var banner = document.getElementById('cookie-banner');
            if (banner) {
              var sync = function () {
                el.style.display = banner.hidden ? '' : 'none';
              };
              sync();
              new MutationObserver(sync).observe(banner, { attributes: true, attributeFilter: ['hidden'] });
            }
            if (banner && !banner.hidden) window.addEventListener('consent:change', function () { setTimeout(load, 300); }, { once: true });
            else setTimeout(load, 1500);
          };
          if (document.readyState === 'complete') start();
          else window.addEventListener('load', start);
        })();
      </script>
    </>
  )
}

<style is:global>
  /* Aviso que sustituye al widget cuando el visitante ya ha usado sus conversaciones del día. */
  .fi-asistente-aviso {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    /* Deja sitio al botón de WhatsApp, que va abajo a la derecha. */
    max-width: min(22rem, calc(100vw - 6.5rem));
    padding: 0.875rem 1rem;
    border: 1px solid #3b2a1e;
    border-radius: 0.75rem;
    background: #17100c;
    color: #f5eee8;
    font: 0.875rem/1.45 'IBM Plex Sans', 'Segoe UI', Roboto, Arial, sans-serif;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }
  .fi-asistente-aviso p {
    margin: 0;
  }
  .fi-asistente-aviso a {
    color: #ff7a1a;
    text-decoration: underline;
  }
  .fi-asistente-aviso button {
    flex: none;
    border: 0;
    background: none;
    color: #b9aca2;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  /* Colores de la web en el widget: tarjeta oscura y botones en el naranja de FAIRINO España. Las variables puestas
     desde fuera mandan sobre las que el widget define en su :host. */
  elevenlabs-convai {
    --el-base: #17100c;
    --el-base-hover: #22180f;
    --el-base-active: #2c1f15;
    --el-base-border: #3b2a1e;
    --el-base-subtle: #b9aca2;
    --el-base-primary: #f5eee8;
    --el-base-error: #ff6b5b;
    --el-accent: #ff7a1a;
    --el-accent-hover: #ff8a3d;
    --el-accent-active: #ff6a13;
    --el-accent-border: #ff7a1a;
    --el-accent-subtle: #ffa040;
    --el-accent-primary: #070504;
    /* Letra de la web (IBM Plex Sans, ya cargada) en vez de la del sistema (system-ui/Segoe UI), que en algunos
       Chrome de Windows sale como símbolos. */
    --font-sans: 'IBM Plex Sans', 'Segoe UI', Roboto, Arial, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, Consolas, monospace;
    font-family: var(--font-sans);
  }
</style>

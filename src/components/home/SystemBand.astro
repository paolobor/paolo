---
import { getImage } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/url';
import { findImage } from '../../lib/images';
import VideoSources from '../ui/VideoSources.astro';

const blocks = [
  { icon: 'box', title: '10 cobots', text: 'De 3 a 30 kg de carga y hasta 1900 mm de alcance.' },
  { icon: 'cpu', title: '4 controladores', text: 'A red o en continua, compactos o de 5 kW.' },
  { icon: 'scan-eye', title: 'Visión y fuerza', text: 'Cámara 3D y sensores de fuerza y par de seis ejes.' },
  { icon: 'hand', title: 'Garras y mandos', text: 'Pinza eléctrica, Safety Box, Smart Tool y Teach Pendant.' },
];

// De fondo, un FAIRINO soldando: vídeo oficial de fairino.com (el bucle de su aplicación de soldadura), recortado
// sin los destellos más fuertes, sin sonido y en bucle. Solo se descarga y se reproduce cuando la sección está a la vista.
const posterImg = findImage('videos/fairino-ecosistema-poster.jpg');
const poster = posterImg ? (await getImage({ src: posterImg, format: 'webp', width: 1280 })).src : undefined;
---

<section class="eco section relative isolate overflow-hidden" aria-labelledby="system-title" data-bgvideo>
  <div class="eco-bg" aria-hidden="true">
    <video class="eco-video" muted loop playsinline preload="none" poster={poster} disablepictureinpicture tabindex="-1" data-bgvideo-video>
      <VideoSources webm="media/fairino-ecosistema.webm" mp4="media/fairino-ecosistema.mp4" />
    </video>
  </div>
  <div class="eco-shade" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
    <div class="grid gap-6" data-reveal>
      <p class="eyebrow flex items-center gap-2.5"><span class="eco-dot" aria-hidden="true"></span>Ecosistema FAIRINO</p>
      <h2 id="system-title" class="h-section max-w-[20ch]">Monta tu sistema de automatización</h2>
      <p class="lead text-mist">
        Cobot, controlador, garra, visión y seguridad del mismo fabricante. Todo es 100 % compatible con FAIRINO, así que
        no pierdes semanas integrando piezas de distintas marcas.
      </p>
      <ul class="grid gap-3">
        {['Una sola plataforma de software para todo el conjunto', 'Un único interlocutor para soporte y repuestos', 'Ampliable cuando tu producción lo pida'].map((t) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-brand text-white shadow-[0_0_0_4px_rgba(255,138,61,0.14)]"><Icon name="check" size={14} strokeWidth={3} /></span>
            <span>{t}</span>
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href={url('cobots/')} class="btn btn-primary">Ver el catálogo <Icon name="arrow-right" size={18} /></a>
        <a href="#configurador" class="btn btn-secondary eco-glass">Configurar mi célula</a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      {
        blocks.map((b, i) => (
          <div class:list={['eco-card grid content-start gap-3 p-4 sm:p-6', i % 2 === 1 && 'translate-y-6']} data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="eco-icon grid size-11 place-items-center rounded-xl text-brand"><Icon name={b.icon} size={22} /></span>
            <p class="eco-title font-display text-[1.05rem] leading-tight font-bold sm:text-xl">{b.title}</p>
            <p class="text-sm text-mist/85">{b.text}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="eco-caption container-x relative">
    <span>Vídeo oficial de FAIRINO · soldadura colaborativa</span>
    <button type="button" class="eco-toggle" aria-label="Pausar el vídeo de fondo" data-bgvideo-toggle hidden>
      <Icon name="pause" size={14} />
    </button>
  </div>
</section>

<style>
  .eco {
    background: var(--color-ink);
  }
  .eco-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .eco-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* el cobot queda a la derecha, detrás de las tarjetas, que son de cristal */
    object-position: 60% 50%;
    opacity: 0.7;
    filter: saturate(0.9) contrast(1.05);
  }
  /* Sombra para leer el texto: más oscura a la izquierda, fundida con el negro arriba y abajo y un brillo cálido. */
  .eco-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, var(--color-ink) 0%, transparent 16%, transparent 84%, var(--color-ink) 100%),
      linear-gradient(90deg, rgb(7 5 4 / 0.95) 0%, rgb(7 5 4 / 0.86) 34%, rgb(7 5 4 / 0.34) 64%, rgb(7 5 4 / 0.55) 100%),
      radial-gradient(ellipse 45% 55% at 68% 55%, rgb(255 122 26 / 0.12), transparent 70%);
  }
  @media (max-width: 1023px) {
    .eco-shade {
      background:
        linear-gradient(180deg, var(--color-ink) 0%, rgb(7 5 4 / 0.82) 14%, rgb(7 5 4 / 0.72) 55%, rgb(7 5 4 / 0.86) 88%, var(--color-ink) 100%);
    }
  }

  /* Punto naranja que late junto al antetítulo */
  .eco-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 10px rgb(255 122 26 / 0.8);
  }
  .eco-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgb(255 122 26 / 0.6);
    animation: eco-ping 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
  }
  @keyframes eco-ping {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* Tarjetas oscuras semitransparentes: dejan ver el cobot moviéndose detrás (sin desenfoque de fondo, que sobre el
     vídeo cuesta mucho al navegador) */
  .eco-card {
    position: relative;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: var(--radius-card);
    background: linear-gradient(160deg, rgb(28 20 15 / 0.78), rgb(11 7 5 / 0.7));
    box-shadow: 0 24px 60px -34px rgb(0 0 0 / 0.9);
    transition:
      transform 0.35s var(--ease-out-soft, ease),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  /* línea de luz arriba */
  .eco-card::before {
    content: '';
    position: absolute;
    left: 18px;
    right: 18px;
    top: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 122 26 / 0.55), transparent);
    opacity: 0.45;
    transition: opacity 0.35s ease;
  }
  .eco-card:hover {
    border-color: rgb(255 122 26 / 0.38);
    box-shadow: 0 26px 60px -28px rgb(255 106 19 / 0.38);
  }
  .eco-card:hover::before {
    opacity: 1;
  }
  .eco-icon {
    background: rgb(255 122 26 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 122 26 / 0.22);
    transition: background-color 0.35s ease;
  }
  .eco-card:hover .eco-icon {
    background: rgb(255 122 26 / 0.18);
  }
  .eco-title {
    font-stretch: 105%;
  }
  @media (min-width: 640px) {
    .eco-title {
      font-stretch: 115%;
    }
  }
  .eco-glass {
    background: rgb(7 5 4 / 0.65);
  }

  /* Crédito del vídeo y botón de pausa, abajo a la derecha */
  .eco-caption {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 3.5rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(245 238 232 / 0.45);
  }
  .eco-toggle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    color: rgb(245 238 232 / 0.75);
    background: rgb(7 5 4 / 0.4);
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .eco-toggle:hover,
  .eco-toggle:focus-visible {
    border-color: var(--color-signal);
    color: var(--color-signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .eco-dot::after {
      animation: none;
    }
  }
</style>


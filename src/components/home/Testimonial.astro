---
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import { testimonial } from '../../data/home';
---

<section class="relative isolate overflow-hidden bg-ink text-white" aria-label="Testimonio de cliente">
  <div class="absolute inset-0 -z-10">
    <SmartImage src={testimonial.image} alt="" hint={testimonial.imageHint} kind="RENDER" tone="dark" class="opacity-60" />
    <div class="absolute inset-0 bg-[linear-gradient(100deg,rgba(7,5,4,0.95)_30%,rgba(7,5,4,0.55))]"></div>
  </div>
  <div class="container-x section">
    <figure class="grid max-w-[52rem] gap-8" data-reveal>
      <Icon name="quote" size={44} class="text-signal" />
      <blockquote class="font-display text-[clamp(1.5rem,3vw,2.4rem)] font-semibold leading-snug" style="font-stretch:108%">
        {testimonial.quote ? <p>“{testimonial.quote}”</p> : <p class="font-mono text-lg font-medium text-[#ffe7a3]">[TESTIMONIO REAL: cita de un cliente sobre su célula FAIRINO, 2–3 frases]</p>}
      </blockquote>
      <figcaption class="flex items-center gap-4">
        <span class="h-px w-10 bg-signal"></span>
        <span>
          <b class="block">{testimonial.author ?? '[DATO: nombre]'}</b>
          <span class="text-mist">{testimonial.role ?? '[DATO: cargo]'}, {testimonial.company ?? '[DATO: empresa]'}</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

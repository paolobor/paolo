---
import Icon from '../ui/Icon.astro';
import Placeholder from '../ui/Placeholder.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { solutions } from '../../data/solutions';
import { url } from '../../lib/url';
---

<section class="section bg-paper" aria-labelledby="turnkey-title">
  <div class="container-x">
    <SectionHeading
      id="turnkey-title"
      eyebrow="Llave en mano"
      title="Células completas, listas para producir"
      lead="Te entregamos la célula montada, programada y con tu equipo formado. Tú solo pones la pieza."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        solutions.map((s, i) => (
          <article class="card card-hover flex flex-col overflow-hidden" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="aspect-[16/11]">
              {s.image ? <img src={url(s.image)} alt={s.imageHint} loading="lazy" class="size-full object-cover" /> : <Placeholder label={s.imageHint} />}
            </div>
            <div class="flex flex-1 flex-col gap-4 p-6">
              <span class="chip w-fit">Solución llave en mano</span>
              <h3 class="text-xl font-bold" style="font-stretch:115%">{s.name}</h3>
              <p class="text-muted">{s.summary}</p>
              <div class="grid gap-1.5 border-t border-line pt-4 text-sm">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-muted">Incluye</p>
                {s.includes ? (
                  <ul class="grid gap-1">{s.includes.map((x) => <li class="flex gap-2"><Icon name="check" size={16} class="mt-0.5 text-brand" />{x}</li>)}</ul>
                ) : (
                  <span class="todo w-fit">[DATO: componentes incluidos en la {s.name.toLowerCase()}]</span>
                )}
              </div>
              <div class="mt-auto flex flex-wrap gap-2 pt-2">
                <a href={url(`soluciones-llave-en-mano/#${s.slug}`)} class="btn btn-secondary btn-sm">Ver detalles</a>
                <a href={url('contacto/')} class="btn btn-primary btn-sm">Pedir propuesta</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

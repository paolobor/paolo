---
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import IllustrativeBadge from '../ui/IllustrativeBadge.astro';
import { isIllustrative } from '../../lib/images';
import { applications } from '../../data/applications';
import { kits } from '../../data/kits';
import KitCard from '../KitCard.astro';
import { url } from '../../lib/url';
---

<section class="section" aria-labelledby="apps-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading
        id="apps-title"
        eyebrow="Aplicaciones"
        title="Qué puede hacer un cobot FAIRINO por tu planta"
        lead={`Ocho tareas en las que un cobot rinde desde el primer turno y ${kits.length} soluciones FAIRINO listas para trabajar. Si la tuya no está, pregúntanos.`}
      />
      <div class="flex shrink-0 flex-wrap gap-3" data-reveal>
        <a href={url('aplicaciones/')} class="btn btn-primary">Ver aplicaciones</a>
        <a href={url('contacto/')} class="btn btn-secondary">Consultar mi caso</a>
      </div>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        applications.map((a, i) => (
          <li data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
            <div class="app relative aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] bg-navy">
              <div class="app-bg absolute inset-0">
                <SmartImage src={a.image} alt="" hint={a.imageHint} tone="dark" align="top" position={a.imagePosition} widths={[320, 480, 720]} sizes="(min-width: 1024px) 25vw, 50vw" />
              </div>
              {a.image && isIllustrative(a.image) && <IllustrativeBadge class="right-2 top-2 px-2! text-[0.5rem]!" />}
              <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_30%,rgba(7,5,4,0.94))]" />
              <div class="absolute inset-x-0 bottom-0 grid gap-2 p-4 text-white sm:p-5">
                <span class="grid size-10 place-items-center rounded-lg bg-black/45 text-signal">
                  <Icon name={a.icon} size={20} />
                </span>
                <span class="font-display text-lg font-bold sm:text-xl" style="font-stretch:115%">{a.name}</span>
                <span class="app-text text-sm text-mist">{a.short}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Soluciones de aplicación FAIRINO (src/data/kits.ts): una a una, en una fila que se desliza -->
    <div class="mt-14 flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div class="grid gap-1.5">
        <p class="eyebrow flex items-center gap-2"><span class="kit-dot" aria-hidden="true"></span>Soluciones FAIRINO</p>
        <h3 class="font-display text-[clamp(1.35rem,2.4vw,1.8rem)] font-bold" style="font-stretch:115%">{kits.length} soluciones listas para trabajar</h3>
      </div>
      <a href={url('aplicaciones/soluciones/')} class="link-arrow shrink-0">Ver todas <Icon name="arrow-right" size={17} /></a>
    </div>
    <ul class="kit-row mt-6" aria-label="Soluciones de aplicación FAIRINO">
      {kits.map((k) => <li><KitCard kit={k} compact /></li>)}
    </ul>
  </div>
</section>

<style>
  .kit-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(16rem, 74%);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 122 26 / 0.5) transparent;
    padding-bottom: 0.75rem;
  }
  .kit-row > li {
    scroll-snap-align: start;
  }
  .kit-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-signal, #ff7a1a);
    box-shadow: 0 0 0.6rem rgb(255 122 26 / 0.8);
  }
  /* Solo fotos: las tarjetas no llevan a ninguna página (para eso está «Ver aplicaciones»). */
  /* En móvil la tarjeta es pequeña: solo icono y nombre. */
  .app-text {
    display: none;
  }
  @media (min-width: 640px) {
    .app-text {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>

---
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { applications } from '../../data/applications';
import { url } from '../../lib/url';
---

<section class="section" aria-labelledby="apps-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading
        id="apps-title"
        eyebrow="Aplicaciones"
        title="Qué puede hacer un cobot FAIRINO por tu planta"
        lead="Ocho tareas en las que un cobot rinde desde el primer turno. Si la tuya no está, pregúntanos."
      />
      <div class="flex shrink-0 flex-wrap gap-3" data-reveal>
        <a href={url('aplicaciones/')} class="btn btn-primary">Ver aplicaciones</a>
        <a href={url('contacto/')} class="btn btn-secondary">Consultar mi caso</a>
      </div>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        applications.map((a, i) => (
          <li data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
            <a href={url(`aplicaciones/${a.slug}/`)} class="app group relative block aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] bg-navy">
              <div class="app-bg absolute inset-0">
                <SmartImage src={a.image} alt="" hint={a.imageHint} tone="dark" align="top" widths={[320, 480, 720]} sizes="(min-width: 1024px) 25vw, 50vw" />
              </div>
              <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_30%,rgba(10,22,38,0.94))]" />
              <div class="absolute inset-x-0 bottom-0 grid gap-2 p-4 text-white sm:p-5">
                <span class="grid size-10 place-items-center rounded-lg bg-white/10 text-signal backdrop-blur transition-colors group-hover:bg-signal group-hover:text-ink">
                  <Icon name={a.icon} size={20} />
                </span>
                <span class="font-display text-lg font-bold sm:text-xl" style="font-stretch:115%">{a.name}</span>
                <span class="app-text text-sm text-mist">{a.short}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .app-bg {
    transition: transform 0.6s var(--ease-out-soft);
  }
  .app:hover .app-bg,
  .app:focus-visible .app-bg {
    transform: scale(1.06);
  }
  /* En móvil la tarjeta es pequeña: solo icono y nombre. */
  .app-text {
    display: none;
  }
  @media (min-width: 640px) {
    .app-text {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
  @media (hover: hover) and (min-width: 1024px) {
    .app-text {
      max-height: 0;
      opacity: 0;
      transition:
        max-height 0.45s var(--ease-out-soft),
        opacity 0.3s;
    }
    .app:hover .app-text,
    .app:focus-visible .app-text {
      max-height: 5rem;
      opacity: 1;
    }
  }
</style>

---
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import { advice } from '../../data/home';
import { site } from '../../data/site';
import { url } from '../../lib/url';

const [titleBefore, titleAfter] = advice.title.split(advice.accent);
const phone = site.contacts[0];
---

<section class="advice section bg-paper fx-aurora" aria-labelledby="advice-title">
  <!-- Fondo: rejilla técnica que se desplaza despacio y se funde hacia los bordes -->
  <div class="advice-grid" aria-hidden="true"></div>
  <div class="container-x grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div class="relative" data-reveal>
      <!-- halo naranja que gira detrás de la foto y esquinas de encuadre -->
      <div class="advice-halo" aria-hidden="true"></div>
      <div class="advice-frame" aria-hidden="true"></div>
      <div class="fx-kenburns relative aspect-[4/3] overflow-hidden rounded-[var(--radius-card)] border border-white/10 shadow-[0_40px_90px_-40px_rgba(0,0,0,0.95)] lg:aspect-[5/4]">
        <SmartImage src={advice.image} alt={advice.imageHint} sizes="(min-width: 1024px) 55vw, 100vw" />
        <span class="advice-scan" aria-hidden="true"></span>
        <span class="advice-live absolute top-4 right-4"><span class="advice-live-dot" aria-hidden="true"></span>Cobots en demostración</span>
        <div class="absolute bottom-4 left-4 flex items-center gap-3 rounded-xl bg-surface/90 px-4 py-3 shadow-lg">
          <span class="fx-ping text-brand"><Icon name="map-pin" size={20} /></span>
          <span class="text-sm"><b class="block">{site.address.city}</b><span class="text-muted">{site.address.region}{site.address.street && ` · ${site.address.street}`}</span></span>
        </div>
      </div>
    </div>

    <div class="grid gap-6" data-reveal style="--reveal-delay:100ms">
      <p class="eyebrow flex items-center gap-2.5"><span class="advice-dot" aria-hidden="true"></span>Te asesoramos gratis</p>
      <h2 id="advice-title" class="h-section max-w-[18ch]">
        {titleBefore}<span class="advice-accent">{advice.accent}</span>{titleAfter}
      </h2>
      <p class="lead">{advice.text}</p>

      <div class="grid gap-2.5">
        <p class="advice-label">Como prefieras</p>
        <div class="flex flex-wrap gap-2.5">
          {
            advice.modes.map((m) => (
              <a href={url(`reservar-cita/?tipo=${m.value}`)} class="advice-mode">
                <Icon name={m.icon} size={17} />
                {m.label}
                <Icon name="arrow-right" size={15} class="advice-mode-arrow" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a href={url('reservar-cita/')} class="btn btn-primary"><Icon name="calendar" size={18} />Reservar cita</a>
        <a href={url('contacto/')} class="btn btn-secondary">Escribirnos</a>
      </div>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
        <span class="inline-flex items-center gap-2"><Icon name="shield-check" size={16} class="text-signal" />Sin coste y sin compromiso</span>
        {
          phone && (
            <a href={`tel:${phone.tel}`} class="inline-flex items-center gap-2 transition-colors hover:text-white">
              <Icon name="phone" size={16} class="text-signal" />o llámanos al <b class="font-semibold text-white/90">{phone.phone}</b>
            </a>
          )
        }
      </p>
    </div>
  </div>

  <!-- Los tres pasos: se iluminan uno tras otro y la línea que los une se va llenando (scripts/fx.ts) -->
  <div class="container-x mt-14 lg:mt-20">
    <div class="mb-6 flex items-center gap-4" data-reveal>
      <p class="advice-label shrink-0">Así lo hacemos</p>
      <span class="advice-rule" aria-hidden="true"></span>
    </div>
    <ol class="grid gap-5 lg:grid-cols-3" data-fx-cycle="3200">
      {
        advice.steps.map((s, i) => (
          <li class="advice-step" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="advice-node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="advice-card fx-spot grid content-start gap-3 overflow-hidden p-5 sm:p-6">
              <span class="fx-progress" aria-hidden="true" />
              <span class="advice-icon grid size-11 place-items-center rounded-xl text-brand"><Icon name={s.icon} size={22} /></span>
              <h3 class="font-display text-lg leading-snug font-bold" style="font-stretch:110%">{s.title}</h3>
              <p class="text-sm text-muted">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .advice-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 32% 50%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 75% 85% at 32% 50%, #000 15%, transparent 72%);
    overflow: hidden;
  }
  /* La rejilla se desplaza con transform (sin repintar la sección en cada fotograma); la máscara queda quieta. */
  .advice-grid::before {
    content: '';
    position: absolute;
    inset: -44px 0 0 -44px;
    background-image:
      linear-gradient(rgb(255 122 26 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 122 26 / 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    animation: advice-grid 30s linear infinite;
  }
  @keyframes advice-grid {
    to {
      transform: translate(44px, 44px);
    }
  }
  .advice-halo {
    position: absolute;
    inset: -9%;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
    background: conic-gradient(
      from var(--fx-a),
      rgb(255 122 26 / 0) 0deg,
      rgb(255 122 26 / 0.55) 70deg,
      rgb(255 176 96 / 0.12) 160deg,
      rgb(255 106 19 / 0.45) 250deg,
      rgb(255 122 26 / 0) 360deg
    );
    filter: blur(70px);
    opacity: 0.55;
    /* Quieto: girar un degradado con 70 px de desenfoque obligaba a recalcularlo en cada fotograma. */
  }
  /* Esquinas de encuadre, como un visor */
  .advice-frame {
    --c: rgb(255 122 26 / 0.85);
    --l: 26px;
    position: absolute;
    inset: -12px;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(var(--c), var(--c)) left top / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) left top / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) right top / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) right top / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) left bottom / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) left bottom / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) right bottom / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) right bottom / 2px var(--l) no-repeat;
    animation: advice-frame 4.5s ease-in-out infinite;
  }
  @keyframes advice-frame {
    0%,
    100% {
      inset: -12px;
      opacity: 0.85;
    }
    50% {
      inset: -18px;
      opacity: 0.45;
    }
  }
  @media (max-width: 639px) {
    .advice-frame {
      --l: 18px;
    }
  }

  /* Línea de escáner que barre la foto de arriba abajo, como en un visor */
  .advice-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(255 138 61 / 0.9) 30%, rgb(255 200 150 / 0.95) 50%, rgb(255 138 61 / 0.9) 70%, transparent);
    box-shadow:
      0 0 14px 2px rgb(255 122 26 / 0.45),
      0 -30px 40px -10px rgb(255 122 26 / 0.12);
    opacity: 0;
    animation: advice-scan 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes advice-scan {
    0% {
      top: 0%;
      opacity: 0;
    }
    8%,
    42% {
      opacity: 0.75;
    }
    50% {
      top: 100%;
      opacity: 0;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* Etiqueta de cristal arriba a la derecha de la foto */
  .advice-live {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(7 5 4 / 0.62);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(245 238 232 / 0.9);
  }
  .advice-live-dot,
  .advice-dot {
    position: relative;
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 10px rgb(255 122 26 / 0.8);
  }
  .advice-live-dot::after,
  .advice-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgb(255 122 26 / 0.6);
    animation: advice-ping 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
  }
  @keyframes advice-ping {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* «gratuito» resaltado con un degradado naranja que brilla despacio */
  .advice-accent {
    background: linear-gradient(100deg, var(--color-signal) 0%, #ffb36b 35%, #fff1e2 50%, #ffb36b 65%, var(--color-signal) 100%);
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: advice-shine 7s ease-in-out 2;
  }
  @keyframes advice-shine {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0% 0;
    }
  }

  .advice-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(245 238 232 / 0.55);
  }
  .advice-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgb(255 122 26 / 0.45), rgb(255 255 255 / 0.08) 40%, transparent);
  }

  /* Visita o videollamada: enlazan a la cita con el tipo ya elegido */
  .advice-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgb(245 238 232 / 0.92);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .advice-mode :global(svg) {
    color: var(--color-signal);
  }
  .advice-mode :global(.advice-mode-arrow) {
    margin-left: -0.1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .advice-mode:hover,
  .advice-mode:focus-visible {
    border-color: rgb(255 122 26 / 0.55);
    background: rgb(255 122 26 / 0.08);
    color: #fff;
  }
  .advice-mode:hover :global(.advice-mode-arrow),
  .advice-mode:focus-visible :global(.advice-mode-arrow) {
    opacity: 1;
    transform: none;
  }

  /* Pasos: número en un nodo, tarjeta debajo (a la derecha en el móvil) y una línea entre nodos que se llena */
  .advice-step {
    --node: 44px;
    --gap: 1.25rem;
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    gap: 1rem;
    align-items: start;
    align-content: start;
  }
  .advice-step:not(:last-child)::before,
  .advice-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - 1px);
    top: calc(var(--node) / 2);
    width: 2px;
    height: calc(100% + var(--gap));
    pointer-events: none;
  }
  .advice-step:not(:last-child)::before {
    background: rgb(255 255 255 / 0.1);
  }
  .advice-step:not(:last-child)::after {
    background: linear-gradient(180deg, var(--color-signal), #ffb36b);
    box-shadow: 0 0 10px rgb(255 122 26 / 0.6);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  /* tramo ya recorrido: hay un paso posterior iluminado */
  .advice-step:has(~ .advice-step .is-lit)::after {
    transform: scaleY(1);
  }
  @media (min-width: 1024px) {
    /* tarjetas de la misma altura */
    .advice-step {
      grid-template-columns: 1fr;
      grid-template-rows: var(--node) 1fr;
      align-items: stretch;
    }
    .advice-step:not(:last-child)::before,
    .advice-step:not(:last-child)::after {
      left: calc(var(--node) / 2);
      top: calc(var(--node) / 2 - 1px);
      width: calc(100% + var(--gap));
      height: 2px;
    }
    .advice-step:not(:last-child)::after {
      background: linear-gradient(90deg, var(--color-signal), #ffb36b);
      transform: scaleX(0);
      transform-origin: left;
    }
    .advice-step:has(~ .advice-step .is-lit)::after {
      transform: scaleX(1);
    }
  }

  .advice-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 50%;
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgb(245 238 232 / 0.6);
    transition:
      background-color 0.45s ease,
      border-color 0.45s ease,
      color 0.45s ease,
      box-shadow 0.45s ease;
  }
  .advice-step:has(~ .advice-step .is-lit) .advice-node {
    border-color: rgb(255 122 26 / 0.7);
    color: var(--color-signal);
  }
  .advice-step:has(.is-lit) .advice-node {
    border-color: var(--color-signal);
    background: var(--color-signal);
    color: #fff;
    box-shadow:
      0 0 0 6px rgb(255 122 26 / 0.14),
      0 0 26px rgb(255 122 26 / 0.55);
  }

  .advice-card {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--radius-card);
    background: linear-gradient(160deg, rgb(28 20 15 / 0.7), rgb(11 7 5 / 0.45));
    box-shadow: 0 24px 60px -36px rgb(0 0 0 / 0.9);
    transition:
      border-color 0.45s ease,
      transform 0.45s ease;
  }
  .advice-card.is-lit {
    border-color: rgb(255 122 26 / 0.22);
  }
  .advice-icon {
    background: rgb(255 122 26 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 122 26 / 0.22);
    transition:
      background-color 0.45s ease,
      color 0.45s ease;
  }
  .advice-card.is-lit .advice-icon,
  .advice-card:hover .advice-icon {
    background: var(--color-brand);
    color: #fff;
  }
</style>

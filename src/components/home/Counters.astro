---
import { counters } from '../../data/home';
---

<section class="bg-brand text-white" aria-label="FAIRINO España en cifras">
  <div class="container-x grid grid-cols-2 gap-x-6 gap-y-10 py-14 md:py-16 lg:grid-cols-4">
    {
      counters.map((c, i) => (
        <div class="grid content-start gap-2 border-l border-white/25 pl-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          {c.value != null ? (
            <p class="font-mono text-[clamp(2.4rem,5vw,3.5rem)] font-medium leading-none tracking-tight tabular-nums">
              <span data-count-to={c.value}>{c.value}</span>
              {c.suffix}
            </p>
          ) : (
            <p class="font-mono text-base leading-snug text-[#ffe7a3]">[DATO: {c.hint}]</p>
          )}
          <p class="text-[0.95rem] text-[#ffe3d0]">{c.label}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Cuenta desde 0 al entrar en pantalla, una sola vez.
  const els = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nf = new Intl.NumberFormat('es-ES');
  if (!reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo);
      const start = performance.now();
      const dur = 1600;
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = nf.format(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.5 },
    );
    els.forEach((el) => {
      el.textContent = '0';
      io.observe(el);
    });
  }
</script>

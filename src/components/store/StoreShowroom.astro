---
// Escaparate de la tienda con el diseño del catálogo online de FAIRINO Spain: carrusel de los cobots,
// nombre gigante detrás, peana luminosa (código, no imagen), cifras clave, precio y panel de especificaciones.
import { getImage } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { getProducts } from '../../lib/catalog';
import { applications } from '../../data/applications';
import { solutions } from '../../data/solutions';
import { formatEUR } from '../../lib/store';
import { site } from '../../data/site';
import { url, formatNumber } from '../../lib/url';

const cobots = (await getProducts('cobot')).filter((c) => !c.data.upcoming);
// Mismo número que la pestaña «Todos» de la tienda: productos más soluciones llave en mano.
const allCount = (await getProducts()).length + solutions.length;
const maxPayload = Math.max(...cobots.map((c) => c.data.payloadKg ?? 0));
const maxReach = Math.max(...cobots.map((c) => c.data.reachMm ?? 0));
const minReach = Math.min(...cobots.map((c) => c.data.reachMm ?? Infinity));
const spec = (c: (typeof cobots)[number], label: string) => c.data.specs.find((s) => s.label === label);
const vatNote = site.store.vatIncluded === true ? 'IVA incluido' : site.store.vatIncluded === false ? '+ IVA' : '';

const slides = await Promise.all(
  cobots.map(async (c, i) => {
    const src = c.data.images[0]?.src;
    const main = src ? await getImage({ src, height: 900, format: 'webp' }) : null;
    const side = src ? await getImage({ src, width: 420, format: 'webp' }) : null;
    const payload = c.data.payloadKg ?? 0;
    const klass = payload <= 5 ? 'Ligero' : payload <= 16 ? 'Carga media' : payload >= 30 ? 'Máxima carga' : 'Carga alta';
    const app = applications.find((a) => a.slug === c.data.applications[0])?.name;
    const weight = spec(c, 'Peso')?.value;
    const payloadMax = spec(c, 'Carga máxima')?.value;
    // Escala visual según el tamaño real: un FR3 se ve más pequeño que un FR20.
    const reach = c.data.reachMm ?? minReach;
    const scale = 0.82 + (0.18 * (reach - minReach)) / (maxReach - minReach || 1);
    return {
      id: c.id,
      i,
      name: c.data.name,
      tags: ['Robot colaborativo', klass, app].filter(Boolean).join(' · '),
      description: c.data.description,
      img: main?.src ?? null,
      imgW: main?.attributes.width ?? 600,
      imgH: main?.attributes.height ?? 900,
      imgSide: side?.src ?? null,
      alt: c.data.images[0]?.alt ?? `Cobot FAIRINO ${c.data.name}`,
      scale,
      readout: [
        { k: 'Carga útil', v: c.data.payloadKg != null ? formatNumber(c.data.payloadKg) : null, u: 'kg', extra: payloadMax ? `máx. ${payloadMax} kg` : '' },
        { k: 'Alcance', v: c.data.reachMm != null ? formatNumber(c.data.reachMm) : null, u: 'mm', extra: '' },
        { k: 'Repetibilidad', v: c.data.repeatabilityMm != null ? `±${formatNumber(c.data.repeatabilityMm)}` : null, u: 'mm', extra: '' },
        { k: 'Peso', v: weight != null ? String(weight).replace('≈ ', '') : null, u: 'kg', extra: '' },
      ],
      price: c.data.store.price,
      versions: c.data.store.versions,
      specs: c.data.specs,
    };
  }),
);
const total = slides.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="showroom relative isolate overflow-hidden bg-ink text-white" aria-roledescription="carrusel" aria-label="Cobots FAIRINO" data-showroom>
  <div class="showroom-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <canvas class="pointer-events-none absolute inset-0 -z-5 h-full w-full" data-embers="back" aria-hidden="true"></canvas>

  <!-- Cabecera del escaparate -->
  <div class="container-x relative grid gap-6 pt-24 md:grid-cols-[1fr_auto] md:items-start lg:pt-24">
    <div class="grid gap-3">
      <p class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-mist">
        <span class="size-2 rounded-full border border-signal"></span>
        Distribuidor oficial FAIRINO · Spain
      </p>
      <h1 class="text-[clamp(1.8rem,3.4vw,2.7rem)] font-extrabold leading-[1.02]" style="font-stretch:118%">
        Robots colaborativos<br /><span class="text-glow">FAIRINO</span>
      </h1>
      <a href="#productos" class="see-all btn btn-primary group mt-1 w-fit gap-3 rounded-full py-3.5 pr-3 pl-6 text-base">
        Ver todos los productos
        <span class="rounded-full bg-ink/15 px-2 py-1 font-mono text-xs tabular-nums">{allCount}</span>
        <span class="see-all-arrow grid size-8 place-items-center rounded-full bg-ink text-signal"><Icon name="chevron-down" size={18} /></span>
      </a>
    </div>
    <div class="grid justify-items-start gap-1 font-mono md:justify-items-end">
      <span class="text-[0.68rem] uppercase tracking-[0.16em] text-mist">Modelo</span>
      <span class="text-3xl font-medium tabular-nums" aria-live="polite"><span data-count>01</span> / {pad(total)}</span>
      <span class="text-[0.68rem] uppercase tracking-[0.16em] text-mist">Serie FR · 6 ejes</span>
    </div>
  </div>

  <!-- Escenario -->
  <div class="stage relative mx-auto -mt-4 h-[min(60vh,580px)] min-h-[380px] max-w-[1600px]" data-stage>
    <span class="backlight" aria-hidden="true"></span>
    <div class="ghost-wrap" data-parallax><p class="ghost" aria-hidden="true" data-ghost style={`--chars:${slides[0].name.length}`}>{slides[0].name}</p></div>
    <span class="floor" aria-hidden="true"></span>

    <span class="beam" aria-hidden="true"></span>
    <!-- Foco de techo: aro naranja arriba y un cono de luz cálida que baja hasta la peana. -->
    <svg class="lamp" viewBox="0 0 400 90" aria-hidden="true">
      <defs>
        <radialGradient id="lamp-fill" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffe2c2" stop-opacity="0.32" />
          <stop offset="45%" stop-color="#ff7a26" stop-opacity="0.16" />
          <stop offset="80%" stop-color="#3a1206" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#000" stop-opacity="0" />
        </radialGradient>
      </defs>
      <ellipse cx="200" cy="45" rx="190" ry="38" fill="url(#lamp-fill)" />
      <ellipse cx="200" cy="45" rx="150" ry="28" fill="none" stroke="#ff8a3d" stroke-width="2.4" filter="url(#plat-glow)" class="lamp-ring" />
      <ellipse cx="200" cy="45" rx="174" ry="33" fill="none" stroke="#ff5a1f" stroke-width="1.8" stroke-dasharray="1 9" stroke-linecap="round" filter="url(#plat-glow)" class="plat-dots" />
    </svg>
    <span class="spot" aria-hidden="true"></span>
    <svg class="platform" viewBox="0 0 400 90" aria-hidden="true">
      <defs>
        <radialGradient id="plat-fill" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ff8a3d" stop-opacity="0.55" />
          <stop offset="45%" stop-color="#ff5a14" stop-opacity="0.3" />
          <stop offset="75%" stop-color="#3a1206" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#000" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="plat-core" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffd2a0" stop-opacity="0.55" />
          <stop offset="40%" stop-color="#ff8a3d" stop-opacity="0.3" />
          <stop offset="100%" stop-color="#ff6a13" stop-opacity="0" />
        </radialGradient>
        <filter id="plat-glow" x="-20%" y="-60%" width="140%" height="220%">
          <feGaussianBlur stdDeviation="3" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <ellipse cx="200" cy="45" rx="196" ry="40" fill="url(#plat-fill)" />
      <ellipse cx="200" cy="45" rx="120" ry="20" fill="url(#plat-core)" />
      <ellipse cx="200" cy="45" rx="150" ry="28" fill="none" stroke="#ff8a3d" stroke-width="2.6" filter="url(#plat-glow)" class="plat-ring" />
      <ellipse cx="200" cy="45" rx="176" ry="34" fill="none" stroke="#ff5a1f" stroke-width="2" stroke-dasharray="1 9" stroke-linecap="round" filter="url(#plat-glow)" class="plat-dots" />
      <ellipse cx="200" cy="45" rx="196" ry="40" fill="none" stroke="#ff7a1a" stroke-opacity="0.35" stroke-width="1" />
    </svg>

    <ul class="robots" data-robots>
      {
        slides.map((s) => (
          <li class="robot" data-robot={s.i} data-active={s.i === 0 ? '' : undefined} style={`--size:${s.scale};--i:${s.i}`}>
            <span class="contact" aria-hidden="true" />
            <span class="robot-btn">
              {s.img ? (
                <>
                  <img class="robot-img" src={s.img} alt={s.i === 0 ? s.alt : ''} width={s.imgW} height={s.imgH} loading={s.i < 3 || s.i === total - 1 ? 'eager' : 'lazy'} decoding="async" />
                  <span class="rim" style={`--mask:url(${s.img})`} aria-hidden="true" />
                  <span class="scan" style={`--mask:url(${s.img})`} aria-hidden="true" />
                </>
              ) : (
                <span class="robot-missing">[FOTO: {s.name}]</span>
              )}
            </span>
          </li>
        ))
      }
    </ul>

    <canvas class="embers-front" data-embers="front" aria-hidden="true"></canvas>

    <!-- Zonas laterales: clic a la izquierda = modelo anterior, a la derecha = siguiente. -->
    <button type="button" class="side side-prev" data-side="-1" aria-label="Modelo anterior">
      <span class="side-label"><span class="side-k">Anterior</span><span class="side-name" data-side-name></span></span>
    </button>
    <button type="button" class="side side-next" data-side="1" aria-label="Modelo siguiente">
      <span class="side-label"><span class="side-k">Siguiente</span><span class="side-name" data-side-name></span></span>
    </button>
  </div>

  <!-- Datos del cobot activo -->
  <div class="container-x relative pb-8">
    {
      slides.map((s) => (
        <div class="info grid justify-items-center gap-4 text-center" data-info={s.i} hidden={s.i !== 0} id={`cobot-${s.id}`}>
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-mist">{s.tags}</p>
          <h2 class="model-name text-[clamp(2.4rem,5.5vw,4rem)] font-extrabold leading-none" style="font-stretch:125%">{s.name}</h2>
          <dl class="grid grid-cols-2 gap-x-10 gap-y-4 sm:grid-cols-4">
            {s.readout.map((r) => (
              <div class="grid justify-items-center gap-0.5">
                <dt class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-mist">{r.k}</dt>
                <dd class="font-mono text-2xl font-medium tabular-nums">
                  {r.v != null ? (
                    <>
                      {r.v}
                      <span class="ml-1 text-sm text-mist">{r.u}</span>
                    </>
                  ) : (
                    <span class="todo">[DATO]</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>

          {s.versions.length > 1 && (
            <fieldset class="flex flex-wrap justify-center gap-2">
              <legend class="sr-only">Versión del {s.name}</legend>
              {s.versions.map((v, vi) => (
                <label class="vpill">
                  <input type="radio" name={`ver-${s.id}`} value={v.id} checked={vi === 0} class="sr-only" data-version-for={s.id} />
                  <span>{v.label}{v.delta ? ` +${formatEUR(v.delta)}` : ''}</span>
                </label>
              ))}
            </fieldset>
          )}

          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
            <p class="font-mono">
              <span class="text-[0.62rem] uppercase tracking-[0.14em] text-mist">PVP</span>{' '}
              <span class="text-2xl text-white">{s.price != null ? formatEUR(s.price) : 'Consultar'}</span>
              {vatNote && <span class="ml-1 text-xs text-mist">{vatNote}</span>}
            </p>
            <button type="button" class="btn btn-primary" data-add-cart={s.id} data-name={s.name} data-open-cart>
              <Icon name="plus" size={18} />
              Añadir al carrito
            </button>
            <button type="button" class="btn btn-ghost" data-specs-open={s.i}>
              <Icon name="sliders-horizontal" size={18} />
              Ver especificaciones
            </button>
            <a href={url(`productos/${s.id}/`)} class="link-arrow text-sm">
              Ficha completa <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <div class="container-x flex flex-col gap-1 border-t border-white/10 py-4 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-mist/70 md:flex-row md:justify-between">
    <span>{site.legalName} · {site.address.city} ({site.address.region})</span>
    <span>Especificaciones según fairino.es · sujetas a cambios sin previo aviso</span>
  </div>
</section>

<!-- Panel de especificaciones -->
<div class="fixed inset-0 z-[65] bg-black/70 backdrop-blur-sm" hidden data-specs-overlay></div>
<aside class="specs fixed inset-y-0 right-0 z-[66] flex w-full max-w-[620px] flex-col border-l border-line bg-surface text-text" role="dialog" aria-modal="true" aria-label="Especificaciones" hidden data-specs>
  <header class="flex items-center justify-between gap-3 border-b border-line px-6 py-4">
    <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-mist">Especificaciones · Cobot · <span data-specs-n>1</span> de {total}</p>
    <div class="flex gap-2">
      <button type="button" class="round-btn" aria-label="Cobot anterior" data-specs-prev><Icon name="chevron-left" size={18} /></button>
      <button type="button" class="round-btn" aria-label="Cobot siguiente" data-specs-next><Icon name="chevron-right" size={18} /></button>
      <button type="button" class="round-btn" aria-label="Cerrar especificaciones" data-specs-close><Icon name="x" size={18} /></button>
    </div>
  </header>
  <div class="flex-1 overflow-y-auto" data-specs-scroll>
    {
      slides.map((s) => (
        <article class="grid gap-8 px-6 py-6" data-specs-panel={s.i} hidden={s.i !== 0}>
          <div class="grid items-center gap-6 sm:grid-cols-[200px_1fr]">
            <div class="spec-card relative grid aspect-[4/5] place-items-center overflow-hidden rounded-2xl border border-line">
              {s.imgSide ? <img src={s.imgSide} alt="" class="relative z-10 h-[88%] w-auto object-contain" loading="lazy" /> : <span class="font-mono text-xs text-mist">[FOTO: {s.name}]</span>}
            </div>
            <div class="grid gap-3">
              <p class="inline-flex items-center gap-2 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-mist">
                <span class="size-2 rounded-full border border-signal"></span>
                {s.tags}
              </p>
              <h3 class="text-5xl font-extrabold leading-none" style="font-stretch:125%">{s.name}</h3>
              <p class="text-sm leading-relaxed text-mist">{s.description}</p>
            </div>
          </div>

          <dl class="readout" style="--cols:4">
            {s.readout.map((r) => (
              <div class="!py-3">
                <dt>{r.k}</dt>
                <dd class="!text-lg">
                  {r.v != null ? `${r.v} ${r.u}` : <span class="todo">[DATO]</span>}
                  {r.extra && <span class="block text-[0.65rem] text-mist">{r.extra}</span>}
                </dd>
              </div>
            ))}
          </dl>

          <section class="grid gap-4">
            <h4 class="text-lg font-bold" style="font-stretch:112%">Dónde encaja en la gama</h4>
            <div class="grid gap-6 sm:grid-cols-2">
              {[
                { t: 'Carga útil (kg)', key: 'payloadKg' as const, max: maxPayload },
                { t: 'Alcance (mm)', key: 'reachMm' as const, max: maxReach },
              ].map((g) => (
                <div class="grid gap-1.5">
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-mist">{g.t}</p>
                  {cobots.map((c) => {
                    const v = c.data[g.key] ?? 0;
                    const me = c.id === s.id;
                    return (
                      <div class="grid grid-cols-[64px_1fr_44px] items-center gap-2 font-mono text-[0.68rem]">
                        <span class={me ? 'text-white' : 'text-mist'}>{c.data.name}</span>
                        <span class="h-1.5 overflow-hidden rounded-full bg-white/5">
                          <span class:list={['bar block h-full rounded-full', me ? 'bg-signal shadow-[0_0_12px_var(--color-signal)]' : 'bg-white/25']} style={`--w:${(v / g.max) * 100}%`} />
                        </span>
                        <span class:list={['text-right tabular-nums', me ? 'text-signal' : 'text-mist']}>{formatNumber(v)}</span>
                      </div>
                    );
                  })}
                </div>
              ))}
            </div>
          </section>

          <section class="grid gap-3">
            <h4 class="text-lg font-bold" style="font-stretch:112%">Especificaciones técnicas</h4>
            <table class="w-full text-left text-sm">
              <tbody>
                {s.specs.map((sp) => (
                  <tr class="border-b border-line">
                    <th scope="row" class="w-1/2 py-2.5 pr-3 font-medium text-mist">{sp.label}</th>
                    <td class="py-2.5 font-mono">{sp.value != null ? `${sp.value}${sp.unit ? ` ${sp.unit}` : ''}` : <span class="todo">[DATO]</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <div class="flex flex-wrap items-center gap-3 border-t border-line pt-5">
            <p class="mr-auto font-mono text-xl">{s.price != null ? formatEUR(s.price) : 'Consultar'} {vatNote && <span class="text-xs text-mist">{vatNote}</span>}</p>
            <button type="button" class="btn btn-primary" data-add-cart={s.id} data-name={s.name} data-open-cart>
              <Icon name="plus" size={18} />
              Añadir al carrito
            </button>
            <a href={url(`productos/${s.id}/`)} class="btn btn-ghost">Ficha completa</a>
          </div>
        </article>
      ))
    }
  </div>
</aside>

<style>
  /* Botón para bajar al catálogo completo: naranja, con brillo que respira y flecha que invita a bajar. */
  .see-all {
    position: relative;
    box-shadow:
      0 0 0 0 rgb(255 122 26 / 0.55),
      0 12px 36px -10px rgb(255 122 26 / 0.8);
    animation: see-all-pulse 2.6s ease-out infinite;
  }
  .see-all:hover {
    animation: none;
  }
  .see-all-arrow {
    animation: see-all-bounce 1.6s ease-in-out infinite;
  }
  .see-all:hover .see-all-arrow {
    animation: none;
    transform: translateY(2px);
  }
  @keyframes see-all-pulse {
    0% {
      box-shadow:
        0 0 0 0 rgb(255 122 26 / 0.55),
        0 12px 36px -10px rgb(255 122 26 / 0.8);
    }
    70%,
    100% {
      box-shadow:
        0 0 0 14px rgb(255 122 26 / 0),
        0 12px 36px -10px rgb(255 122 26 / 0.8);
    }
  }
  @keyframes see-all-bounce {
    0%,
    100% {
      transform: translateY(-1px);
    }
    50% {
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .see-all,
    .see-all-arrow {
      animation: none;
    }
  }
  .showroom-glow {
    background:
      radial-gradient(ellipse 80% 75% at 50% 50%, transparent 50%, rgb(0 0 0 / 0.66)),
      radial-gradient(ellipse 50% 42% at 50% 56%, rgb(255 106 19 / 0.2), transparent 70%),
      radial-gradient(ellipse 34% 34% at 22% 52%, rgb(200 40 20 / 0.16), transparent 70%),
      radial-gradient(ellipse 30% 30% at 78% 46%, rgb(255 140 40 / 0.1), transparent 70%),
      linear-gradient(rgb(255 122 26 / 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 122 26 / 0.035) 1px, transparent 1px) 0 0 / 48px 48px;
  }
  .ghost {
    position: absolute;
    inset-inline: 0;
    top: 2%;
    margin: 0;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    /* Los nombres largos («FR5 Negro») se encogen para que quepan en el ancho. */
    font-size: clamp(3rem, min(21vw, calc(118vw / var(--chars, 4))), 21rem);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, rgb(52 22 10 / 0.95), rgb(26 11 6 / 0.85) 75%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 120 40 / 0.1);
    transition:
      opacity 0.45s,
      transform 0.6s var(--ease-out-soft);
    user-select: none;
  }
  .ghost.is-changing {
    opacity: 0;
    transform: translateY(12px);
  }
  .platform {
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: min(520px, 80vw);
    transform: translateX(-50%);
    overflow: visible;
    opacity: 0.8;
  }
  .plat-dots {
    animation: plat-spin 24s linear infinite;
    transform-origin: 200px 45px;
  }
  @keyframes plat-spin {
    to {
      stroke-dashoffset: -200;
    }
  }
  .stage {
    touch-action: pan-y;
  }
  .robots {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .robot {
    --x: 0px;
    --s: 1;
    --op: 1;
    --blur: 0px;
    --bright: 1;
    position: absolute;
    left: 50%;
    bottom: 3%;
    height: calc(97% * var(--size));
    max-width: 82vw;
    transform: translateX(calc(-50% + var(--x))) scale(var(--s));
    transform-origin: 50% 100%;
    opacity: var(--op);
    filter: blur(var(--blur)) brightness(var(--bright));
    transition:
      transform 0.7s var(--ease-out-soft),
      opacity 0.6s,
      filter 0.6s;
    z-index: var(--z, 1);
  }
  :global(html:not(.js)) .robot:not([data-active]) {
    display: none;
  }
  .robot-btn {
    position: relative;
    display: block;
    height: 100%;
    animation: float 6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.8s);
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(0.6deg);
    }
  }
  /* Barrido de luz tipo escáner, recortado con la silueta del robot activo. */
  .scan {
    position: absolute;
    inset: 0;
    z-index: 4;
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
    background: linear-gradient(180deg, transparent 0%, rgb(255 170 90 / 0) 40%, rgb(255 170 90 / 0.4) 50%, rgb(255 170 90 / 0) 60%, transparent 100%) 0 0 / 100% 260% no-repeat;
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .robot[data-active] .scan {
    opacity: 1;
    animation: scan 4.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes scan {
    0% {
      background-position: 0 120%;
    }
    60%,
    100% {
      background-position: 0 -20%;
    }
  }
  /* Contraluz cálido detrás del cobot activo: el nombre gigante queda en silueta delante. */
  .backlight {
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: min(980px, 130vw);
    height: 100%;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 26% 40% at 50% 64%, rgb(255 150 70 / 0.32), transparent 72%),
      radial-gradient(ellipse 42% 58% at 50% 60%, rgb(255 96 20 / 0.24), transparent 72%),
      radial-gradient(ellipse 62% 70% at 46% 58%, rgb(190 40 14 / 0.18), transparent 75%);
    filter: blur(8px);
    animation: backlight 7s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes backlight {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 0.9;
    }
  }
  /* Suelo: línea de horizonte encendida y un baño de luz naranja que se apaga hacia delante. */
  .floor {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 16%;
    background:
      radial-gradient(ellipse 42% 140% at 50% 0%, rgb(255 110 30 / 0.13), transparent 70%),
      linear-gradient(180deg, rgb(6 3 2 / 0.6), rgb(6 3 2 / 0));
    pointer-events: none;
  }
  .floor::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 122 26 / 0.22) 18%, rgb(255 180 110 / 0.62) 50%, rgb(255 122 26 / 0.22) 82%, transparent);
    box-shadow: 0 0 12px 1px rgb(255 106 19 / 0.32);
  }
  .embers-front {
    position: absolute;
    inset: -10% 0 0;
    z-index: 15;
    width: 100%;
    height: 110%;
    pointer-events: none;
  }
  .beam {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: min(360px, 56vw);
    height: 86%;
    transform: translateX(-50%);
    background: linear-gradient(0deg, rgb(255 120 40 / 0.2), rgb(255 106 19 / 0.045) 55%, transparent);
    clip-path: polygon(18% 100%, 82% 100%, 62% 0, 38% 0);
    filter: blur(6px);
    animation: beam 5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes beam {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  /* Foco de techo (más tenue que la peana) y su cono de luz, por delante del robot en modo «pantalla». */
  .lamp {
    --lamp-top: -7%;
    position: absolute;
    left: 50%;
    top: var(--lamp-top);
    width: min(300px, 50vw);
    transform: translateX(-50%);
    overflow: visible;
    opacity: 0.6;
    pointer-events: none;
  }
  .spot {
    position: absolute;
    left: 50%;
    top: calc(var(--lamp-top, -7%) + min(34px, 5.6vw));
    bottom: 5%;
    width: min(560px, 92vw);
    transform: translateX(-50%);
    background: linear-gradient(180deg, rgb(255 230 200 / 0.15), rgb(255 186 130 / 0.07) 42%, rgb(255 140 70 / 0.025) 78%, transparent);
    clip-path: polygon(30% 0, 70% 0, 97% 100%, 3% 100%);
    filter: blur(10px);
    mix-blend-mode: screen;
    z-index: 12;
    animation: spot 6s ease-in-out infinite;
    pointer-events: none;
  }
  /* En móvil el contador va encima del escenario: el foco baja un poco para no taparlo. */
  @media (max-width: 767px) {
    .stage {
      --lamp-top: 1%;
    }
    .lamp {
      --lamp-top: 1%;
      width: 44vw;
    }
  }
  @keyframes spot {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }
  .lamp-ring {
    animation: ring 3s ease-in-out infinite;
    animation-delay: -1.5s;
  }
  .plat-ring {
    animation: ring 3s ease-in-out infinite;
  }
  @keyframes ring {
    0%,
    100% {
      stroke-opacity: 0.75;
    }
    50% {
      stroke-opacity: 1;
      stroke-width: 3;
    }
  }
  .side {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    width: 36%;
    padding: 0 clamp(16px, 3vw, 48px);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .side-prev {
    left: 0;
    justify-content: flex-start;
  }
  .side-next {
    right: 0;
    justify-content: flex-end;
    text-align: right;
  }
  .side::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .side-prev::before {
    background: radial-gradient(ellipse 60% 55% at 0% 55%, rgb(255 106 19 / 0.16), transparent 70%);
  }
  .side-next::before {
    background: radial-gradient(ellipse 60% 55% at 100% 55%, rgb(255 106 19 / 0.16), transparent 70%);
  }
  .side-label {
    position: relative;
    display: grid;
    gap: 2px;
    opacity: 0;
    transform: translateX(var(--nudge, 0));
    transition:
      opacity 0.35s,
      transform 0.5s var(--ease-out-soft);
  }
  .side-prev .side-label {
    --nudge: -10px;
  }
  .side-next .side-label {
    --nudge: 10px;
  }
  .side-k {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-signal);
  }
  .side-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    font-stretch: 112%;
    color: var(--color-text);
  }
  .side:active::before,
  .side:focus-visible::before,
  .side:focus-visible .side-label {
    opacity: 1;
    transform: none;
  }
  .side:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: -6px;
    border-radius: 16px;
  }
  @media (hover: hover) {
    .side:hover::before,
    .side:hover .side-label {
      opacity: 1;
      transform: none;
    }
    /* El robot hacia el que vas se ilumina un poco. */
    .stage:has(.side-prev:hover) .robot[data-off='-1'],
    .stage:has(.side-next:hover) .robot[data-off='1'] {
      opacity: 0.9;
      filter: blur(0) brightness(0.95);
    }
  }
  .robot-img {
    position: relative;
    z-index: 2;
    display: block;
    width: auto;
    height: 100%;
    max-width: 82vw;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    filter: drop-shadow(0 0 1.5px rgb(255 150 70 / 0.22)) drop-shadow(0 0 20px rgb(255 96 20 / 0.13));
  }
  .robot[data-active] .robot-img {
    filter: drop-shadow(0 0 1.5px rgb(255 160 80 / 0.34)) drop-shadow(0 0 26px rgb(255 96 20 / 0.2));
  }
  /* Contraluz cálido desde la peana: tinte naranja recortado con la silueta del propio robot (no altera su forma). */
  .rim {
    position: absolute;
    inset: 0;
    z-index: 3;
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
    background:
      radial-gradient(ellipse 60% 32% at 50% 100%, rgb(255 96 20 / 0.42), transparent 72%),
      linear-gradient(90deg, rgb(255 110 30 / 0.24), transparent 22%, transparent 78%, rgb(255 130 40 / 0.2));
    mix-blend-mode: screen;
    opacity: 0.45;
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .robot[data-active] .rim {
    opacity: 0.8;
  }
  .contact {
    position: absolute;
    left: 50%;
    bottom: -1%;
    z-index: 1;
    width: 46%;
    height: 7%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.85), transparent);
    animation: shadow 6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.8s);
  }
  @keyframes shadow {
    0%,
    100% {
      transform: translateX(-50%) scale(1);
      opacity: 1;
    }
    50% {
      transform: translateX(-50%) scale(0.82);
      opacity: 0.6;
    }
  }
  .robot-missing {
    display: grid;
    place-items: center;
    height: 100%;
    aspect-ratio: 4 / 5;
    border: 1.5px dashed rgb(255 255 255 / 0.25);
    border-radius: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-mist);
  }
  .vpill span {
    display: inline-flex;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .vpill input:checked + span {
    border-color: var(--color-signal);
    background: rgb(255 122 26 / 0.14);
    color: #fff;
  }
  .vpill input:focus-visible + span {
    outline: 3px solid var(--color-signal);
    outline-offset: 2px;
  }
  .info:not([hidden]) {
    animation: info-in 0.5s var(--ease-out-soft);
  }
  @keyframes info-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .specs {
    animation: specs-in 0.35s var(--ease-out-soft);
  }
  @keyframes specs-in {
    from {
      transform: translateX(100%);
    }
  }
  .round-btn {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
  }
  .round-btn:hover {
    border-color: var(--color-signal);
    color: var(--color-signal);
  }
  .spec-card {
    background:
      radial-gradient(circle at 50% 55%, rgb(255 90 20 / 0.35), transparent 55%),
      radial-gradient(circle at 50% 50%, #1a0e08, #0b0705 70%);
  }
  .spec-card::after {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    border: 3px solid rgb(230 50 30 / 0.85);
    box-shadow: 0 0 24px rgb(230 50 30 / 0.6);
  }
  .bar {
    width: 0;
    transition: width 0.9s var(--ease-out-soft);
  }
  [data-specs-panel]:not([hidden]) .bar {
    width: var(--w);
  }
  .ghost-wrap {
    position: absolute;
    inset: 0;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform 0.6s var(--ease-out-soft);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .plat-dots,
    .robot-btn,
    .contact,
    .robot[data-active] .scan,
    .beam,
    .spot,
    .backlight,
    .lamp-ring,
    .plat-ring {
      animation: none;
    }
    .ghost-wrap {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-showroom]');
  if (root) {
    const robots = [...root.querySelectorAll<HTMLElement>('[data-robot]')];
    const infos = [...root.querySelectorAll<HTMLElement>('[data-info]')];
    const ghost = root.querySelector<HTMLElement>('[data-ghost]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const specs = document.querySelector<HTMLElement>('[data-specs]');
    const specsOverlay = document.querySelector<HTMLElement>('[data-specs-overlay]');
    const panels = [...document.querySelectorAll<HTMLElement>('[data-specs-panel]')];
    const n = robots.length;
    const names = infos.map((i) => i.querySelector('.model-name')?.textContent?.trim() ?? '');
    const ids = infos.map((i) => i.id.replace('cobot-', ''));
    const sides = [...root.querySelectorAll<HTMLButtonElement>('[data-side]')];
    let index = 0;
    let lastFocus: HTMLElement | null = null;

    const layout = () => {
      const w = root.clientWidth;
      // En móvil los robots laterales asoman por el borde en vez de taparse con el activo.
      const step = w < 640 ? w * 0.5 : Math.min(400, w * 0.25);
      robots.forEach((r, i) => {
        // Distancia circular al activo (−4…4).
        let o = i - index;
        if (o > n / 2) o -= n;
        if (o < -n / 2) o += n;
        const a = Math.abs(o);
        const visible = a <= 2;
        r.style.setProperty('--x', `${o * step}px`);
        r.style.setProperty('--s', String(a === 0 ? 1 : a === 1 ? 0.56 : 0.4));
        r.style.setProperty('--op', String(!visible ? 0 : a === 0 ? 1 : a === 1 ? 0.72 : 0.34));
        r.style.setProperty('--blur', `${a === 0 ? 0 : a === 1 ? 0.6 : 2}px`);
        r.style.setProperty('--bright', String(a === 0 ? 1 : a === 1 ? 0.8 : 0.62));
        r.style.setProperty('--z', String(10 - a));
        r.dataset.off = String(o);
        r.toggleAttribute('data-active', a === 0);
        const img = r.querySelector('img');
        if (img) img.alt = a === 0 ? `Cobot FAIRINO ${names[i]}` : '';
      });
    };

    const show = (i: number, opts: { hash?: boolean } = {}) => {
      index = (i + n) % n;
      layout();
      infos.forEach((el, k) => (el.hidden = k !== index));
      if (count) count.textContent = String(index + 1).padStart(2, '0');
      sides.forEach((b) => {
        const dir = Number(b.dataset.side);
        const name = names[(index + dir + n) % n];
        const label = b.querySelector('[data-side-name]');
        if (label) label.textContent = name;
        b.setAttribute('aria-label', `${dir < 0 ? 'Modelo anterior' : 'Modelo siguiente'}: ${name}`);
      });
      if (ghost) {
        ghost.classList.add('is-changing');
        window.setTimeout(() => {
          ghost.textContent = names[index];
          ghost.style.setProperty('--chars', String(names[index].length));
          ghost.classList.remove('is-changing');
        }, 220);
      }
      panels.forEach((p, k) => (p.hidden = k !== index));
      const sn = document.querySelector('[data-specs-n]');
      if (sn) sn.textContent = String(index + 1);
      if (opts.hash !== false) {
        try {
          history.replaceState(null, '', `#${ids[index]}`);
        } catch {
          /* sin historial */
        }
      }
    };

    const openSpecs = () => {
      if (!specs || !specsOverlay) return;
      lastFocus = document.activeElement as HTMLElement;
      specs.hidden = specsOverlay.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      specs.querySelector<HTMLElement>('[data-specs-close]')?.focus();
    };
    const closeSpecs = () => {
      if (!specs || !specsOverlay) return;
      specs.hidden = specsOverlay.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocus?.focus();
    };

    // Si el gesto fue un deslizamiento, no cuenta también como clic en la zona lateral.
    let swiped = false;
    sides.forEach((b) =>
      b.addEventListener('click', () => {
        if (!swiped) show(index + Number(b.dataset.side));
      }),
    );
    root.querySelectorAll<HTMLElement>('[data-specs-open]').forEach((b) => b.addEventListener('click', openSpecs));
    specs?.querySelector('[data-specs-prev]')?.addEventListener('click', () => show(index - 1));
    specs?.querySelector('[data-specs-next]')?.addEventListener('click', () => show(index + 1));
    specs?.querySelector('[data-specs-close]')?.addEventListener('click', closeSpecs);
    specsOverlay?.addEventListener('click', closeSpecs);

    document.addEventListener('keydown', (e) => {
      const specsOpen = specs && !specs.hidden;
      if (e.key === 'Escape' && specsOpen) return closeSpecs();
      const rect = root.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.6 && rect.bottom > window.innerHeight * 0.4;
      if (!(specsOpen || inView) || (e.target as HTMLElement).closest('input, select, textarea')) return;
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    // Deslizar en móvil.
    let startX = 0;
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    stage?.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      swiped = false;
    });
    stage?.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50) {
        swiped = true;
        show(index + (dx < 0 ? 1 : -1));
      }
    });
    window.addEventListener('resize', layout, { passive: true });

    // Paralaje suave del nombre gigante al mover el ratón.
    const par = root.querySelector<HTMLElement>('[data-parallax]');
    if (par && window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5;
        const dy = (e.clientY - r.top) / r.height - 0.5;
        par.style.setProperty('--px', `${(-dx * 28).toFixed(1)}px`);
        par.style.setProperty('--py', `${(-dy * 14).toFixed(1)}px`);
      });
    }

    // Enlace directo a un modelo: /tienda/#fr5
    const fromHash = ids.indexOf(location.hash.slice(1));
    show(fromHash >= 0 ? fromHash : 0, { hash: false });
  }

  // Brasas flotando: luz ambiental del escaparate (decorativa, se pausa fuera de pantalla).
  const sprite = (stops: [number, string][]) => {
    const c = document.createElement('canvas');
    c.width = c.height = 64;
    const x = c.getContext('2d')!;
    const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    stops.forEach(([o, col]) => g.addColorStop(o, col));
    x.fillStyle = g;
    x.fillRect(0, 0, 64, 64);
    return c;
  };
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLCanvasElement>('[data-embers]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const front = canvas.dataset.embers === 'front';
    const img = front
      ? sprite([[0, 'rgba(255,160,80,0.4)'], [0.55, 'rgba(255,110,40,0.2)'], [1, 'rgba(255,80,20,0)']])
      : sprite([[0, 'rgba(255,225,185,0.85)'], [0.16, 'rgba(255,160,70,0.7)'], [0.42, 'rgba(255,90,20,0.22)'], [1, 'rgba(255,60,10,0)']]);
    type Ember = { x: number; y: number; r: number; vx: number; vy: number; a: number; ph: number; sp: number };
    let w = 0;
    let h = 0;
    let parts: Ember[] = [];
    const spawn = (anywhere: boolean): Ember => {
      const big = !front && Math.random() < 0.14;
      return {
        // Más densas en el centro, donde está la luz.
        x: w * (0.5 + (Math.random() + Math.random() - 1) * 0.62),
        y: anywhere ? Math.random() * h : h + 30,
        r: front ? 14 + Math.random() * 22 : big ? 5 + Math.random() * 5 : 1.6 + Math.random() * 2.6,
        vx: (Math.random() - 0.5) * 8,
        vy: -(front ? 5 + Math.random() * 9 : 10 + Math.random() * 26),
        a: front ? 0.14 + Math.random() * 0.16 : big ? 0.22 + Math.random() * 0.22 : 0.5 + Math.random() * 0.5,
        ph: Math.random() * Math.PI * 2,
        sp: 0.5 + Math.random() * 1.5,
      };
    };
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = front ? Math.round(Math.min(6, w / 200)) : Math.round(Math.min(90, (w * h) / 13000));
      parts = Array.from({ length: n }, () => spawn(true));
    };
    let last = performance.now();
    let running = false;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';
      for (const p of parts) {
        p.ph += dt * p.sp;
        p.y += p.vy * dt;
        p.x += (p.vx + Math.sin(p.ph) * 9) * dt;
        if (p.y < -40) Object.assign(p, spawn(false));
        // Se apagan al subir y parpadean un poco, como brasas.
        const life = Math.max(0, Math.min(1, p.y / h));
        ctx.globalAlpha = p.a * (0.72 + 0.28 * Math.sin(p.ph * 3.3)) * (0.3 + 0.7 * life);
        const d = p.r * 2;
        ctx.drawImage(img, p.x - d, p.y - d, d * 2, d * 2);
      }
      if (running) requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || reduceMotion || document.hidden) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };
    const stop = () => (running = false);
    resize();
    frame(last);
    new ResizeObserver(() => {
      resize();
      if (!running) frame(performance.now());
    }).observe(canvas);
    let onScreen = false;
    new IntersectionObserver(([e]) => ((onScreen = e.isIntersecting) ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden || !onScreen ? stop() : start()));
  });
</script>

---
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import { formatEUR } from '../../lib/store';
import { url } from '../../lib/url';

interface Props {
  product: CollectionEntry<'products'>;
  // En la tienda: al pulsar la imagen se elige el producto y se muestran sus compatibles a la izquierda.
  selectable?: boolean;
}
const { product, selectable = false } = Astro.props;
const d = product.data;
const Media = selectable ? 'button' : 'a';
const mediaAttrs = selectable
  ? { type: 'button' as const, 'data-select': product.id, 'aria-label': `Elegir ${d.name} y ver productos compatibles` }
  : { href: url(`productos/${product.id}/`), tabindex: -1, 'aria-hidden': true };
---

<article
  class="store-card group relative flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface transition-[border-color,box-shadow] hover:border-signal/40 hover:shadow-[0_18px_50px_-20px_rgba(255,106,19,0.35)]"
  data-card={product.id}
>
  {
    selectable && (
      <span class="sel-badge pointer-events-none absolute right-3 top-3 z-10 items-center gap-1 rounded-full bg-signal px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-wide text-ink">
        <Icon name="check" size={12} strokeWidth={3} />
        Elegido
      </span>
    )
  }
  <Media
    {...mediaAttrs}
    class="relative block aspect-square w-full overflow-hidden bg-[radial-gradient(ellipse_at_50%_80%,rgba(255,106,19,0.2),transparent_60%),radial-gradient(circle_at_50%_40%,#1a110c,#0b0705_75%)]"
  >
    <div class="absolute inset-0">
      <SmartImage src={d.images[0]?.src} alt="" hint={`${d.name}, foto oficial`} tone="dark" fit="contain" widths={[320, 480, 640]} sizes="(min-width: 1024px) 25vw, 50vw" class="p-6 transition-transform duration-500 group-hover:scale-105" />
    </div>
    {
      selectable && (
        <span class="absolute inset-x-3 bottom-3 rounded-full bg-black/60 px-3 py-1.5 text-center text-xs font-semibold text-white opacity-0 backdrop-blur transition-opacity group-hover:opacity-100">
          Ver lo que encaja con este producto
        </span>
      )
    }
  </Media>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-mist">FAIRINO</p>
    <h3 class="font-display text-lg font-bold leading-tight" style="font-stretch:112%">
      <a href={url(`productos/${product.id}/`)} class="hover:text-signal">{d.name}</a>
    </h3>
    <p class="text-sm text-muted">{d.tagline}</p>
    <div class="mt-auto flex items-center justify-between gap-3 pt-3">
      <span class="font-mono text-lg">{d.store.price != null ? formatEUR(d.store.price) : 'Consultar'}</span>
      <button type="button" class="btn btn-primary btn-sm" data-add-cart={product.id} data-name={d.name} aria-label={`Añadir ${d.name} al carrito`}>
        <Icon name="plus" size={16} />
        Añadir
      </button>
    </div>
  </div>
</article>

<style>
  .sel-badge {
    display: none;
  }
  .store-card[data-selected] {
    border-color: var(--color-signal);
    box-shadow:
      0 0 0 1px var(--color-signal),
      0 18px 50px -20px rgb(255 106 19 / 0.55);
  }
  .store-card[data-selected] .sel-badge {
    display: inline-flex;
  }
</style>

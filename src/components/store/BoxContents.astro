---
// «Qué incluye la caja» de un cobot FAIRINO y el selector de la controladora incluida: AC (a red) o DC (a batería).
// Con `selectable` los botones AC/DC son radios que lee el carrito (data-power-for); sin él, solo explica las dos opciones.
import Icon from '../ui/Icon.astro';
import { BOX_ITEMS, POWER } from '../../data/caja';
import { getProducts, type Product } from '../../lib/catalog';
import { formatEUR } from '../../lib/store';
import { url } from '../../lib/url';

interface Props {
  product: Product;
  selectable?: boolean;
  class?: string;
}
const { product, selectable = false, class: className } = Astro.props;
const big = product.data.compatibleWith.some((id) => id.endsWith('controller-5kw'));
const ctrlModel = big ? '5 kW' : 'Mini 2 kW';
const Tag = selectable ? 'label' : 'div';
// La consola (Teach Pendant) no va en la caja: se compra aparte.
const tp = (await getProducts()).find((p) => p.id === 'teach-pendant' && p.data.compatibleWith.includes(product.id));
---

<div class:list={['bx @container grid w-full gap-4 text-left', className]} data-box={product.id}>
  <div class="grid gap-2.5">
    <p class="bx-k">
      <Icon name="cpu" size={14} />
      {selectable ? 'Elige tu controladora · incluida en el precio' : 'Controladora incluida · tú eliges la alimentación'}
    </p>
    <div class="grid gap-2.5 @min-[30rem]:grid-cols-2" role={selectable ? 'radiogroup' : undefined} aria-label={selectable ? `Alimentación de la controladora del ${product.data.name}` : undefined}>
      {
        POWER.map((w, i) => (
          <Tag class="pw">
            {selectable && <input type="radio" name={`pw-${product.id}`} value={w.id} checked={i === 0} class="sr-only" data-power-for={product.id} />}
            <span class="pw-card">
              <span class="pw-ico">
                <Icon name={w.icon} size={22} />
              </span>
              <span class="grid gap-0.5">
                <span class="pw-name">
                  <b>{w.short}</b> {w.name}
                </span>
                <span class="pw-text">{w.text}</span>
              </span>
              {selectable && (
                <span class="pw-tick" aria-hidden="true">
                  <Icon name="check" size={12} strokeWidth={3} />
                </span>
              )}
            </span>
          </Tag>
        ))
      }
    </div>
  </div>

  <div class="bx-box">
    <p class="bx-k">
      <Icon name="package-check" size={14} />
      Qué incluye la caja <span class="bx-free">Todo incluido en el precio</span>
    </p>
    <ul class="grid grid-cols-2 gap-2 @min-[40rem]:grid-cols-4">
      {
        BOX_ITEMS.map((it) => (
          <li class="bx-item">
            <Icon name={it.icon} size={20} class="text-signal" />
            <span class="bx-name">{it.name}</span>
            <span class="bx-note" data-box-note={it.icon === 'cpu' ? '' : undefined}>
              {it.icon === 'cpu' ? (selectable ? `${ctrlModel} · AC` : `${ctrlModel} · AC o DC`) : it.note}
            </span>
          </li>
        ))
      }
    </ul>
    {
      tp && (
        <p class="bx-tp">
          <span class="flex items-center gap-2">
            <Icon name="plus" size={14} class="text-signal" />
            <span>
              <a href={url(`productos/${tp.id}/`)} class="font-semibold text-white hover:text-signal">Consola {tp.data.name}</a>: no va en la caja, se compra aparte
              {tp.data.store.price != null && <span class="font-mono"> · {formatEUR(tp.data.store.price)}</span>}
            </span>
          </span>
          {selectable && (
            <button type="button" class="bx-tp-btn" data-add-cart={tp.id} data-name={tp.data.name}>
              Añadir
            </button>
          )}
        </p>
      )
    }
  </div>
</div>

{
  selectable && (
    <script>
      // La nota de la controladora en «Qué incluye la caja» sigue a la opción elegida.
      document.addEventListener('change', (e) => {
        const r = e.target as HTMLInputElement;
        if (!r.matches?.('[data-power-for]')) return;
        const note = document.querySelector<HTMLElement>(`[data-box="${r.dataset.powerFor}"] [data-box-note]`);
        if (note) note.textContent = note.textContent!.replace(/(AC|DC)$/, r.value.toUpperCase());
      });
    </script>
  )
}

<style>
  .bx-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-mist);
  }
  .bx-k :global(svg) {
    color: var(--color-signal);
  }
  .bx-free {
    margin-left: auto;
    border-radius: 999px;
    border: 1px solid rgb(37 211 102 / 0.35);
    background: rgb(37 211 102 / 0.1);
    padding: 0.15rem 0.6rem;
    color: #7ee2a4;
    letter-spacing: 0.1em;
  }
  .pw-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.8rem;
    height: 100%;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015));
    padding: 0.85rem 2.2rem 0.85rem 0.85rem;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      box-shadow 0.2s;
  }
  label.pw .pw-card {
    cursor: pointer;
  }
  label.pw:hover .pw-card {
    border-color: rgb(255 122 26 / 0.5);
  }
  .pw-ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 10px;
    border: 1px solid rgb(255 122 26 / 0.35);
    background: rgb(255 122 26 / 0.1);
    color: var(--color-brand);
  }
  .pw-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
  }
  .pw-name b {
    margin-right: 0.3rem;
    font-family: var(--font-mono);
    color: var(--color-signal);
  }
  .pw-text {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .pw-tick {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: transparent;
    transition: all 0.2s;
  }
  .pw input:checked + .pw-card {
    border-color: var(--color-signal);
    background: linear-gradient(160deg, rgb(255 122 26 / 0.18), rgb(255 122 26 / 0.04));
    box-shadow:
      0 0 0 1px var(--color-signal),
      0 12px 34px -16px rgb(255 106 19 / 0.7);
  }
  .pw input:checked + .pw-card .pw-ico {
    background: var(--color-signal);
    color: var(--color-ink);
  }
  .pw input:checked + .pw-card .pw-tick {
    border-color: var(--color-signal);
    background: var(--color-signal);
    color: var(--color-ink);
  }
  .pw input:focus-visible + .pw-card {
    outline: 3px solid var(--color-signal);
    outline-offset: 2px;
  }
  .bx-box {
    display: grid;
    gap: 0.75rem;
    border-radius: 14px;
    border: 1px dashed rgb(255 255 255 / 0.18);
    padding: 0.9rem;
  }
  .bx-tp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    padding-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .bx-tp-btn {
    border-radius: 999px;
    border: 1px solid rgb(255 122 26 / 0.5);
    padding: 0.3rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-brand);
    transition: background-color 0.2s;
  }
  .bx-tp-btn:hover {
    background: rgb(255 122 26 / 0.15);
  }
  .bx-item {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.2rem;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.04);
    padding: 0.7rem;
  }
  .bx-name {
    margin-top: 0.2rem;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
  }
  .bx-note {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-mist);
  }
</style>

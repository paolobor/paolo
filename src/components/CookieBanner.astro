---
import { url } from '../lib/url';
// Aviso de consentimiento (RGPD / guía AEPD): rechazar tan visible como aceptar, sin casillas premarcadas,
// y los scripts no esenciales solo se activan tras el consentimiento (<script type="text/plain" data-consent="analytics">).
// Sale en el centro y tapa la web hasta que se elige (aceptar o rechazar: rechazando también se entra, como pide la
// AEPD). En la política de cookies no tapa nada, para poder leerla antes de decidir. Elegir por tipos (análisis,
// marketing) se hace desde «Configurar cookies» en el pie de página.
---

<section
  id="cookie-banner"
  class="cookie fixed inset-0 z-[60] grid place-items-center bg-[rgba(7,5,4,0.72)] p-4 backdrop-blur-sm data-[soft]:pointer-events-none data-[soft]:inset-auto data-[soft]:bottom-0 data-[soft]:left-0 data-[soft]:right-0 data-[soft]:bg-transparent data-[soft]:backdrop-blur-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-text"
  hidden
>
  <div class="card pointer-events-auto grid w-full max-w-[520px] gap-4 p-6 shadow-[0_24px_60px_-20px_rgba(7,5,4,0.45)] sm:p-7">
    <div class="grid gap-2">
      <h2 id="cookie-title" class="font-display text-2xl font-bold" style="font-stretch:112%">Antes de entrar: cookies</h2>
      <p id="cookie-text" class="text-[15px] text-muted">
        Las técnicas son necesarias para que la web funcione. Con tu permiso usaremos también cookies de análisis para
        mejorarla. Puedes cambiar tu elección cuando quieras desde el pie de página.{' '}
        <a href={url('politica-de-cookies/')} class="font-medium text-brand underline">Más información sobre cookies</a>
      </p>
    </div>

    <form class="grid gap-3" data-cookie-prefs hidden>
      <label class="flex items-start justify-between gap-4 rounded-lg bg-paper p-3 text-sm">
        <span><b class="block">Técnicas</b><span class="text-muted">Imprescindibles: sesión, preferencias y seguridad.</span></span>
        <input type="checkbox" checked disabled class="mt-1 size-4" />
      </label>
      <label class="flex items-start justify-between gap-4 rounded-lg bg-paper p-3 text-sm">
        <span><b class="block">Análisis</b><span class="text-muted">Medir visitas de forma agregada para mejorar la web.</span></span>
        <input type="checkbox" name="analytics" class="mt-1 size-4 accent-[var(--color-brand)]" />
      </label>
      <label class="flex items-start justify-between gap-4 rounded-lg bg-paper p-3 text-sm">
        <span><b class="block">Marketing</b><span class="text-muted">Medir campañas y mostrar contenido relevante.</span></span>
        <input type="checkbox" name="marketing" class="mt-1 size-4 accent-[var(--color-brand)]" />
      </label>
    </form>

    <div class="grid grid-cols-2 gap-2">
      <button type="button" class="btn btn-secondary btn-sm" data-cookie="reject">Rechazar</button>
      <button type="button" class="btn btn-primary btn-sm" data-cookie="accept">Aceptar todas</button>
      <button type="button" class="btn btn-primary btn-sm col-span-2" data-cookie="save" hidden>Guardar mi selección</button>
    </div>
  </div>
</section>

<script>
  const KEY = 'fairino-consent';
  const VERSION = 1;
  // Si se aceptan (todas o alguna), la elección vale 7 días: después el aviso vuelve a salir y no se carga nada hasta
  // que se elija de nuevo (la guía de la AEPD pide renovarlo como mucho cada 24 meses). Si se rechazan todas, vale
  // solo para esta visita (sessionStorage): en la siguiente se vuelve a preguntar.
  const MAX_AGE = 1000 * 60 * 60 * 24 * 7;
  type Consent = { v: number; date: string; analytics: boolean; marketing: boolean };

  const banner = document.getElementById('cookie-banner');
  const prefs = banner?.querySelector<HTMLFormElement>('[data-cookie-prefs]');

  const read = (): Consent | null => {
    try {
      const c = JSON.parse(localStorage.getItem(KEY) || sessionStorage.getItem(KEY) || 'null');
      return c && c.v === VERSION && Date.now() - Date.parse(c.date) < MAX_AGE ? c : null;
    } catch {
      return null;
    }
  };

  const activate = (c: Consent) => {
    document.querySelectorAll<HTMLScriptElement>('script[type="text/plain"][data-consent]').forEach((tpl) => {
      const cat = tpl.dataset.consent as 'analytics' | 'marketing';
      if (!c[cat] || tpl.dataset.activated) return;
      const s = document.createElement('script');
      [...tpl.attributes].forEach((a) => a.name !== 'type' && s.setAttribute(a.name, a.value));
      s.text = tpl.text;
      tpl.dataset.activated = 'true';
      tpl.after(s);
    });
    window.dispatchEvent(new CustomEvent('consent:change', { detail: c }));
  };

  const save = (analytics: boolean, marketing: boolean) => {
    const c: Consent = { v: VERSION, date: new Date().toISOString(), analytics, marketing };
    try {
      localStorage.removeItem(KEY);
      sessionStorage.removeItem(KEY);
      (analytics || marketing ? localStorage : sessionStorage).setItem(KEY, JSON.stringify(c));
    } catch {
      /* almacenamiento bloqueado: la elección vale solo para esta visita */
    }
    if (banner) banner.hidden = true;
    lock(false);
    activate(c);
  };

  const showPrefs = (show: boolean) => {
    if (!banner || !prefs) return;
    prefs.hidden = !show;
    banner.querySelector<HTMLElement>('[data-cookie="save"]')!.hidden = !show;
  };

  // Mientras el aviso tapa la web, la página de detrás no se mueve ni se puede usar con el teclado.
  const soft = location.pathname.includes('politica-de-cookies');
  if (banner && soft) banner.dataset.soft = '';
  const lock = (on: boolean) => {
    if (soft) return;
    document.documentElement.style.overflow = on ? 'hidden' : '';
    document.querySelectorAll<HTMLElement>('body > :not(#cookie-banner):not(.fi-overlay):not(script)').forEach((el) => {
      el.inert = on;
    });
  };

  const open = (withPrefs = false) => {
    if (!banner) return;
    const c = read();
    if (prefs) {
      (prefs.elements.namedItem('analytics') as HTMLInputElement).checked = !!c?.analytics;
      (prefs.elements.namedItem('marketing') as HTMLInputElement).checked = !!c?.marketing;
    }
    showPrefs(withPrefs);
    banner.hidden = false;
    lock(true);
    banner.querySelector<HTMLElement>('[data-cookie="accept"]')?.focus({ preventScroll: true });
  };

  banner?.addEventListener('click', (e) => {
    const action = (e.target as HTMLElement).closest<HTMLElement>('[data-cookie]')?.dataset.cookie;
    if (action === 'accept') save(true, true);
    if (action === 'reject') save(false, false);
    if (action === 'save' && prefs) {
      save(
        (prefs.elements.namedItem('analytics') as HTMLInputElement).checked,
        (prefs.elements.namedItem('marketing') as HTMLInputElement).checked,
      );
    }
  });

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-cookie-settings]')) open(true);
  });

  const existing = read();
  if (existing) activate(existing);
  else open(false);
</script>

---
import Icon from './ui/Icon.astro';
import { site } from '../data/site';
import { whatsappLink } from '../lib/url';

interface Props {
  message?: string;
}
const { message = site.whatsapp.defaultMessage } = Astro.props;
---

<a
  href={whatsappLink(site.whatsapp.number, message)}
  target="_blank"
  rel="noopener"
  class="wa-float fixed right-4 z-40 inline-flex items-center gap-2 rounded-full bg-wa p-3.5 text-[#06331a] shadow-[0_12px_30px_-10px_rgba(7,5,4,0.55)] transition-transform hover:scale-105 sm:right-6 sm:pr-5"
  aria-label="Escríbenos por WhatsApp"
  data-wa-float
>
  <Icon name="si:whatsapp" size={26} />
  <span class="hidden text-sm font-semibold sm:inline">WhatsApp</span>
</a>

<style>
  .wa-float {
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 640px) {
    .wa-float {
      bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

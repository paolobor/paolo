---
import type { GetStaticPaths } from 'astro';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactBand from '../../components/home/ContactBand.astro';
import HumanoidTeaser from '../../components/home/HumanoidTeaser.astro';
import { humanoid } from '../../data/humanoid';
import { applications } from '../../data/applications';
import { site } from '../../data/site';
import { getProducts, categoryMeta, accessoryGroups, type Product } from '../../lib/catalog';
import { url, whatsappLink, formatNumber } from '../../lib/url';
import { SCENE_WIDTHS, CUTOUT_WIDTHS, findImage } from '../../lib/images';
import { fairinoVideos, fairinoChannel } from '../../data/fairino-videos';
import { configSlot } from '../../data/configurator';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
const d = product.data;
// Hueco del configurador: todos los accesorios entran en el paso 4 (src/data/configurator.ts).
const cfgSlot = configSlot(product);
// Si el producto tiene vídeo, va el primero en la galería y las fotos se corren un puesto.
const posterImg = d.video ? findImage(d.video.poster) : null;
const videoPoster = posterImg ? (await getImage({ src: posterImg, format: 'webp', width: Math.min(1280, posterImg.width) })).src : undefined;
const videoThumb = posterImg ? (await getImage({ src: posterImg, format: 'webp', width: 320 })).src : undefined;
const off = d.video ? 1 : 0;
const mediaCount = d.images.length + off;
// «del FR5» o «del DC Mini Controller» va bien; los accesorios tienen nombres en español con género («la pinza»),
// así que en ellos el título va sin el nombre.
const delName = d.category === 'accesorio' ? '' : ` del ${d.name}`;
const meta = categoryMeta[d.category];
const all = await getProducts();

// Vídeos oficiales de FAIRINO del modelo, del más nuevo al más antiguo. Las versiones en negro muestran los de su
// modelo (grabados con el acabado blanco).
const videoModel = product.id.replace(/-negro$/, '');
const videoModelName = all.find((p) => p.id === videoModel)?.data.name ?? d.name;
const videos = await Promise.all(
  fairinoVideos
    .filter((v) => v.models.includes(videoModel))
    .sort((a, b) => b.date.localeCompare(a.date))
    .map(async (v) => {
      const img = findImage(`videos/yt-${v.youtube}.jpg`);
      return {
        ...v,
        poster: img ? (await getImage({ src: img, format: 'webp', width: 640 })).src : undefined,
        when: new Date(`${v.date}T12:00:00Z`).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' }),
        length: v.duration == null ? null : `${Math.floor(v.duration / 60)}:${String(v.duration % 60).padStart(2, '0')}`,
      };
    }),
);

// Productos relacionados según la categoría.
const byId = (ids: string[]) => all.filter((p) => ids.includes(p.id));
let compatible: { title: string; items: Product[] }[] = [];
if (d.category === 'cobot') {
  compatible = [
    { title: 'Controladores compatibles', items: byId(d.compatibleWith) },
    { title: 'Accesorios compatibles', items: all.filter((p) => p.data.category === 'accesorio' && p.data.compatibleWith.includes(product.id)) },
  ];
} else {
  compatible = [{ title: 'Cobots compatibles', items: byId(d.compatibleWith) }];
}
compatible = compatible.filter((c) => c.items.length > 0);

const apps = d.applications.map((s) => applications.find((a) => a.slug === s)).filter((a) => a !== undefined);

const fmt = (v: string | number | null, unit?: string) =>
  v == null ? null : `${typeof v === 'number' ? formatNumber(v) : v}${unit ? ` ${unit}` : ''}`;
const keySpecs =
  d.category === 'cobot'
    ? [
        { k: 'Carga útil', v: fmt(d.payloadKg, 'kg') },
        { k: 'Alcance', v: fmt(d.reachMm, 'mm') },
        { k: 'Repetibilidad', v: d.repeatabilityMm != null ? `±${formatNumber(d.repeatabilityMm)} mm` : null },
      ]
    : d.specs.filter((s) => s.value != null).slice(0, 3).map((s) => ({ k: s.label, v: fmt(s.value, s.unit) }));

const subtitle = d.category === 'accesorio' && d.group ? accessoryGroups[d.group] : meta.singular;
const waMessage = `Hola, me interesa el ${d.name}. ¿Me podéis dar más información?`;
const quoteHref = url(`contacto/?asunto=presupuesto&producto=${encodeURIComponent(d.name)}`);
const downloadIcon: Record<string, string> = { ficha: 'newspaper', manual: 'book-open', cad: 'box', certificado: 'award', software: 'cpu' };
// El manual de instrucciones va destacado (botón arriba y primera tarjeta de las descargas).
const manual = d.downloads.find((x) => x.type === 'manual');
const manualExternal = !!manual?.href?.startsWith('http');
const manualHref = manual?.href ? (manualExternal ? manual.href : url(manual.href)) : null;
const otherDownloads = d.downloads.filter((x) => x !== manual);

const title = d.seo.title ?? `${d.name}: ${meta.singular.toLowerCase()} FAIRINO`;
const description = (d.seo.description ?? `${d.tagline} Ficha técnica, descargas, aplicaciones y presupuesto con FAIRINO España.`).slice(0, 160);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.brand === 'FAIRINO' ? `FAIRINO ${d.name.replace(/^FAIRINO\s+/i, '')}` : `${d.name} (${d.brand})`,
  description: d.description,
  category: meta.singular,
  brand: { '@type': 'Brand', name: d.brand },
  url: new URL(url(`productos/${product.id}/`), Astro.site).toString(),
  ...(d.images.length ? { image: d.images.map((i) => new URL(i.src.src, Astro.site).toString()) } : {}),
  additionalProperty: d.specs
    .filter((s) => s.value != null)
    .map((s) => ({ '@type': 'PropertyValue', name: s.label, value: String(s.value), ...(s.unit ? { unitText: s.unit } : {}) })),
  seller: { '@type': 'Organization', name: site.legalName },
};

const placeholderViews = ['vista principal', 'vista lateral', 'detalle', 'en aplicación'];
---

<BaseLayout title={title} description={description} jsonLd={[productSchema]} whatsappMessage={waMessage}>
  <section class="border-b border-line bg-paper">
    <div class="container-x grid gap-10 py-8 md:py-12 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <div class="lg:col-span-2">
        <Breadcrumbs tone="light" items={[{ label: meta.label, href: meta.href }, { label: d.name }]} />
      </div>

      <!-- Galería -->
      <div class="grid content-start gap-3" data-gallery>
        <div class="relative aspect-[4/3] overflow-hidden rounded-[var(--radius-card)] border border-line bg-[radial-gradient(ellipse_at_50%_85%,rgba(255,106,19,0.22),transparent_60%),radial-gradient(circle_at_50%_40%,#1a110c,#0b0705_75%)]">
          {
            d.video?.youtube && (
              <div class="absolute inset-0 bg-black" data-slide={0} data-yt={d.video.youtube} data-yt-title={d.video.alt}>
                <button type="button" class="group absolute inset-0 block" aria-label={`Reproducir el vídeo: ${d.video.alt}`} data-yt-play>
                  <img src={videoPoster} alt="" class="size-full object-cover" />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/20 transition-colors group-hover:via-black/0"></span>
                  <span class="absolute left-1/2 top-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-signal text-ink shadow-[0_10px_40px_-6px_rgba(255,106,19,0.7)] transition-transform group-hover:scale-110">
                    <Icon name="play" size={28} />
                  </span>
                  <span class="absolute inset-x-4 bottom-3 grid gap-0.5 text-left">
                    <span class="text-sm font-semibold text-white">{d.video.alt}</span>
                    <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-white/75">Vídeo oficial de FAIRINO · se reproduce en YouTube</span>
                  </span>
                </button>
              </div>
            )
          }
          {
            d.video?.mp4 && (
              <div class="absolute inset-0" data-slide={0}>
                <video
                  class="size-full object-cover"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={videoPoster}
                  aria-label={d.video.alt}
                  data-gallery-video
                >
                  {d.video.webm && <source src={url(d.video.webm)} type="video/webm" />}
                  <source src={url(d.video.mp4!)} type="video/mp4" />
                </video>
                <button
                  type="button"
                  class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-black/55 px-3 py-1.5 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-white/90 backdrop-blur transition-colors hover:bg-black/75"
                  aria-label="Pausar el vídeo"
                  data-video-toggle
                >
                  <Icon name="pause" size={14} class="i-pause" />
                  <Icon name="play" size={14} class="i-play hidden" />
                  <span data-video-label>Pausa</span>
                </button>
              </div>
            )
          }
          {
            d.images.length ? (
              d.images.map((img, i) => (
                <div class:list={['absolute inset-0', !img.illustrative && 'p-6']} data-slide={i + off} hidden={i + off !== 0}>
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    widths={img.illustrative ? SCENE_WIDTHS : CUTOUT_WIDTHS}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    formats={['webp']}
                    fallbackFormat="webp"
                    loading={i + off === 0 ? 'eager' : 'lazy'}
                    class:list={['size-full', img.illustrative ? 'object-cover' : 'object-contain']}
                    pictureAttributes={{ class: 'block size-full' }}
                  />
                  {img.illustrative && (
                    <span class="absolute bottom-3 right-3 rounded-full bg-black/55 px-3 py-1 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-white/85 backdrop-blur">
                      Imagen ilustrativa
                    </span>
                  )}
                </div>
              ))
            ) : (
              !d.video && <Placeholder label={`${d.name}, ${placeholderViews[0]} (de fairino.es)`} />
            )
          }
        </div>
        <div class:list={['grid gap-3', mediaCount > 4 ? 'grid-cols-5' : 'grid-cols-4']}>
          {
            mediaCount > 1 && d.video && (
              <button
                type="button"
                class="thumb relative aspect-square overflow-hidden rounded-xl border border-line bg-surface"
                aria-label={`Ver el vídeo: ${d.video.alt}`}
                aria-pressed="true"
                data-thumb={0}
              >
                <img src={videoThumb} alt="" class="size-full object-cover" loading="lazy" />
                <span class="absolute inset-0 grid place-items-center bg-black/25">
                  <span class="grid size-9 place-items-center rounded-full bg-signal text-ink shadow-lg"><Icon name="play" size={16} /></span>
                </span>
              </button>
            )
          }
          {
            mediaCount > 1
              ? d.images.map((img, i) => (
                  <button
                    type="button"
                    class="thumb aspect-square overflow-hidden rounded-xl border border-line bg-surface p-2"
                    aria-label={`Ver imagen ${i + 1}: ${img.alt}`}
                    aria-pressed={i + off === 0 ? 'true' : 'false'}
                    data-thumb={i + off}
                  >
                    <Picture
                      src={img.src}
                      alt=""
                      widths={img.illustrative ? SCENE_WIDTHS.slice(0, 1) : CUTOUT_WIDTHS.slice(0, 1)}
                      sizes="160px"
                      formats={['webp']}
                      fallbackFormat="webp"
                      class:list={['size-full', img.illustrative ? 'rounded-lg object-cover' : 'object-contain']}
                      pictureAttributes={{ class: 'block size-full' }}
                    />
                  </button>
                ))
              : mediaCount === 0 &&
                placeholderViews.slice(1).map((v) => (
                  <div class="aspect-square overflow-hidden rounded-xl">
                    <Placeholder label={v} />
                  </div>
                ))
          }
        </div>
      </div>

      <!-- Información -->
      <div class="grid content-start gap-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip">{subtitle}</span>
          {
            d.upcoming && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-signal/40 bg-signal/10 px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-[0.12em] text-brand">
                <span class="size-1.5 rounded-full bg-signal" aria-hidden="true" />
                Próximamente
              </span>
            )
          }
          <span class="font-mono text-xs uppercase tracking-[0.12em] text-muted">{d.brand}</span>
        </div>
        <div class="grid gap-3">
          <h1 class="text-[clamp(2.6rem,6vw,4rem)] font-extrabold leading-none" style="font-stretch:125%">{d.name}</h1>
          <p class="text-xl text-muted">{d.tagline}</p>
        </div>

        {
          keySpecs.length > 0 && (
            <dl class="readout bg-surface" style={`--cols:${keySpecs.length}`}>
              {keySpecs.map((s) => (
                <div class="!py-3">
                  <dt>{s.k}</dt>
                  <dd class="!text-lg">{s.v ?? <span class="todo">[DATO]</span>}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <p class="text-[1.05rem] leading-relaxed">{d.description}</p>

        {
          d.highlights.length > 0 && (
            <ul class="grid gap-2">
              {d.highlights.map((h) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-brand text-white">
                    <Icon name="check" size={14} strokeWidth={3} />
                  </span>
                  {h}
                </li>
              ))}
            </ul>
          )
        }

        <div class="flex flex-wrap gap-3 pt-1">
          {
            d.upcoming && (
              <a href={url(humanoid.demoHref)} class="btn btn-primary">
                <Icon name="calendar-check" size={18} />
                Reserva tu demo
              </a>
            )
          }
          <a href={quoteHref} class:list={['btn', d.upcoming ? 'btn-secondary' : 'btn-primary']}>
            <Icon name="send" size={18} />
            Solicitar presupuesto
          </a>
          {
            cfgSlot && (
              <button
                type="button"
                class="btn btn-secondary"
                data-add-config={product.id}
                data-slot={cfgSlot}
                data-compat={d.category === 'cobot' ? d.compatibleWith.join(',') : undefined}
              >
                <Icon name="plus" size={18} />
                Añadir al configurador
              </button>
            )
          }
          {
            manual && (
              <a
                href={manualHref ?? '#manual'}
                class="btn btn-secondary manual-btn"
                {...(manualExternal ? { target: '_blank', rel: 'noopener' } : manualHref ? { download: true } : {})}
              >
                <Icon name="book-open" size={18} class="text-signal" />
                Manual de instrucciones
              </a>
            )
          }
        </div>
        <a href={whatsappLink(site.whatsapp.number, waMessage)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold text-text hover:text-brand">
          <Icon name="si:whatsapp" size={18} class="text-[#1fa855]" />
          Preguntar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  {d.upcoming && <HumanoidTeaser id="presentacion" />}

  <!-- Navegación de la ficha -->
  <nav aria-label="Secciones de la ficha" class="sticky top-16 z-30 border-b border-line bg-surface/90 backdrop-blur lg:top-[72px]">
    <ul class="tabs-row container-x flex gap-2 overflow-x-auto py-2.5 text-sm font-semibold" data-section-tabs>
      <li><a href="#especificaciones" class="tab">Especificaciones</a></li>
      <li><a href="#descargas" class="tab">{manual ? 'Manual y descargas' : 'Descargas'}</a></li>
      {videos.length > 0 && <li><a href="#videos" class="tab">Vídeos</a></li>}
      {apps.length > 0 && <li><a href="#aplicaciones" class="tab">Aplicaciones</a></li>}
      {compatible.length > 0 && <li><a href="#compatibles" class="tab">Compatibles</a></li>}
    </ul>
  </nav>

  <!-- Especificaciones -->
  <section id="especificaciones" class="section scroll-mt-32" aria-labelledby="spec-title">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div class="grid content-start gap-4">
        <p class="eyebrow">Ficha técnica</p>
        <h2 id="spec-title" class="h-section">Especificaciones{delName}</h2>
        <p class="text-muted">
          Datos de la documentación de {d.brand}. Si un valor es crítico para tu célula, confírmalo con nuestro equipo antes de cerrar el diseño.
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Especificaciones técnicas: {d.name}</caption>
          <tbody>
            {d.specs.length === 0 && (
              <tr class="border-b border-line">
                <th scope="row" class="w-1/2 py-3.5 pr-4 align-top text-[0.95rem] font-medium text-muted">Ficha técnica</th>
                <td class="py-3.5 align-top"><span class="todo">[DATO: especificaciones: {d.name}]</span></td>
              </tr>
            )}
            {
              d.specs.map((s) => (
                <tr class="border-b border-line">
                  <th scope="row" class="w-1/2 py-3.5 pr-4 align-top text-[0.95rem] font-medium text-muted">{s.label}</th>
                  <td class="py-3.5 align-top font-mono text-[0.95rem] text-text">
                    {s.value != null ? fmt(s.value, s.unit) : <span class="todo">[DATO: {s.label.toLowerCase()}]</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Descargas -->
  <section id="descargas" class="section scroll-mt-32 bg-paper" aria-labelledby="dl-title">
    <div class="container-x grid gap-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="grid gap-3">
          <p class="eyebrow">Documentación</p>
          <h2 id="dl-title" class="h-section">{manual ? 'Manual y descargas' : 'Descargas'}{delName}</h2>
        </div>
        <a href={url('descargas/')} class="link-arrow">Centro de descargas <Icon name="arrow-right" size={17} /></a>
      </div>
      {
        manual && (
          <div id="manual" class="manual-card scroll-mt-40">
            <span class="manual-icon">
              <Icon name="book-open" size={30} />
            </span>
            <div class="grid min-w-0 gap-1.5">
              <p class="eyebrow">Léelo antes de empezar</p>
              <h3 class="font-display text-xl font-extrabold leading-tight md:text-2xl" style="font-stretch:112%">
                {manual.label}
              </h3>
              <p class="text-sm text-muted md:text-base">Documentación oficial para instalarlo, ponerlo en marcha y trabajar con él con seguridad.</p>
            </div>
            {manualHref ? (
              <a
                href={manualHref}
                class="btn btn-primary shrink-0"
                {...(manualExternal ? { target: '_blank', rel: 'noopener' } : { download: true })}
              >
                Abrir el manual
                <Icon name={manualExternal ? 'arrow-up-right' : 'download'} size={18} />
              </a>
            ) : (
              <div class="grid shrink-0 justify-items-start gap-1.5 md:justify-items-end">
                <span class="todo w-fit">[DATO: archivo]</span>
                <a
                  href={`mailto:${site.contacts[0].email}?subject=${encodeURIComponent(`${manual.label} ${d.name}`)}`}
                  class="btn btn-primary"
                >
                  Pedir el manual por correo
                </a>
              </div>
            )}
          </div>
        )
      }
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          otherDownloads.map((dl) => (
            <li>
              {dl.href ? (
                <a
                  href={dl.href.startsWith('http') ? dl.href : url(dl.href)}
                  class="card card-hover flex h-full items-center gap-4 p-5"
                  {...(dl.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : { download: true })}
                >
                  <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand">
                    <Icon name={downloadIcon[dl.type] ?? 'download'} size={22} />
                  </span>
                  <span class="grid">
                    <span class="font-semibold">{dl.label}</span>
                    <span class="font-mono text-xs text-muted">{dl.href.startsWith('http') ? 'Documentación oficial FAIRINO' : d.name}</span>
                  </span>
                  <Icon name={dl.href.startsWith('http') ? 'arrow-up-right' : 'download'} size={18} class="ml-auto shrink-0 text-brand" />
                </a>
              ) : (
                <div class="card flex h-full items-center gap-4 p-5">
                  <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-paper text-muted">
                    <Icon name={downloadIcon[dl.type] ?? 'download'} size={22} />
                  </span>
                  <span class="grid gap-1">
                    <span class="font-semibold">{dl.label}</span>
                    <span class="todo w-fit">[DATO: archivo]</span>
                    <a
                      href={`mailto:${site.contacts[0].email}?subject=${encodeURIComponent(`${dl.label} ${d.name}`)}`}
                      class="text-xs font-semibold text-brand hover:underline"
                    >
                      Pedir por correo
                    </a>
                  </span>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Vídeos oficiales de FAIRINO -->
  {
    videos.length > 0 && (
      <section id="videos" class="section blueprint on-dark scroll-mt-32 text-white" aria-labelledby="videos-title">
        <div class="container-x grid gap-10">
          <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div class="grid gap-3">
              <p class="eyebrow flex items-center gap-2"><Icon name="play" size={16} />Vídeos oficiales de FAIRINO</p>
              <h2 id="videos-title" class="h-section">El {videoModelName} en acción</h2>
              <p class="lead">
                {videos.length === 1 ? 'Vídeo' : `${videos.length} vídeos`} del canal oficial de FAIRINO en los que sale este modelo.
                {videoModel !== product.id && ` Están grabados con el ${videoModelName} blanco: el ${d.name} es el mismo modelo en negro.`}
              </p>
            </div>
            <a href={fairinoChannel} target="_blank" rel="noopener" class="btn btn-secondary shrink-0">
              <Icon name="si:youtube" size={18} class="text-[#ff0033]" />
              Canal de FAIRINO
            </a>
          </div>
          <ul class="grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
            {videos.map((v) => (
              <li>
                <button type="button" class="vid-card group grid w-full gap-3 text-left" data-video-open data-yt={v.youtube} data-title={v.title} data-short={v.short ? '' : undefined} aria-label={`Reproducir el vídeo: ${v.title}`}>
                  <span class="relative block aspect-video overflow-hidden rounded-xl border border-white/10 bg-black">
                    <img src={v.poster} alt="" width="640" height="360" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    <span class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></span>
                    <span class="absolute left-1/2 top-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-signal text-ink shadow-[0_10px_40px_-6px_rgba(255,106,19,0.7)] transition-transform group-hover:scale-110">
                      <Icon name="play" size={24} />
                    </span>
                    <span class="absolute bottom-2 right-2 rounded-md bg-black/75 px-1.5 py-1 font-mono text-[0.68rem] leading-none text-white">{v.short ? 'Short' : v.length}</span>
                  </span>
                  <span class="grid gap-1">
                    <span class="font-semibold leading-snug text-white group-hover:text-signal">{v.title}</span>
                    <span class="text-sm capitalize-first text-white/60">{v.when}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-white/55">Se reproducen en YouTube al pulsar play: hasta entonces no se carga nada de YouTube.</p>
        </div>

        <dialog class="vid-modal" data-video-modal aria-labelledby="vid-modal-title">
          <div class="vid-modal-box">
            <div class="vid-frame" data-video-frame></div>
            <div class="flex items-start justify-between gap-4">
              <p id="vid-modal-title" class="font-semibold text-white" data-video-title></p>
              <button type="button" class="btn btn-secondary btn-sm shrink-0" data-video-close><Icon name="x" size={16} />Cerrar</button>
            </div>
          </div>
        </dialog>
      </section>
    )
  }

  <!-- Aplicaciones -->
  {
    apps.length > 0 && (
      <section id="aplicaciones" class="section scroll-mt-32" aria-labelledby="apps-title">
        <div class="container-x grid gap-8">
          <div class="grid gap-3">
            <p class="eyebrow">Aplicaciones recomendadas</p>
            <h2 id="apps-title" class="h-section">Dónde rinde el {d.name}</h2>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {apps.map((a) => (
              <li>
                <a href={url(`aplicaciones/${a.slug}/`)} class="card card-hover fx-spot group grid h-full content-start gap-3 p-6">
                  <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand transition-colors group-hover:bg-brand group-hover:text-white">
                    <Icon name={a.icon} size={22} />
                  </span>
                  <span class="font-display text-lg font-bold" style="font-stretch:112%">{a.name}</span>
                  <span class="text-sm text-muted">{a.short}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Compatibles -->
  {
    compatible.length > 0 && (
      <section id="compatibles" class="section scroll-mt-32 bg-paper" aria-labelledby="compat-title">
        <div class="container-x grid gap-12">
          <div class="grid gap-3">
            <p class="eyebrow">Ecosistema FAIRINO</p>
            <h2 id="compat-title" class="h-section">Compatible con el {d.name}</h2>
          </div>
          {compatible.map((group) => (
            <div class="grid gap-5">
              <h3 class="text-xl font-bold" style="font-stretch:112%">{group.title}</h3>
              <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                {group.items.map((p) => (
                  <li>
                    <ProductCard product={p} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <ContactBand whatsappMessage={waMessage} />
</BaseLayout>

<style>
  /* Manual de instrucciones destacado */
  .manual-card {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
    padding: 1.5rem;
    overflow: hidden;
    border: 1px solid rgb(255 122 26 / 0.55);
    border-radius: 18px;
    background:
      radial-gradient(ellipse 60% 120% at 0% 50%, rgb(255 122 26 / 0.16), transparent 70%),
      var(--color-surface);
    box-shadow: 0 24px 60px -30px rgb(255 106 19 / 0.45);
  }
  .manual-card > .grid {
    flex: 1 1 18rem;
  }
  .manual-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 16px;
    background: var(--color-signal);
    color: var(--color-ink);
    box-shadow: 0 10px 30px -8px rgb(255 122 26 / 0.7);
  }
  @media (min-width: 768px) {
    .manual-card {
      padding: 1.75rem 2rem;
    }
  }
  .manual-btn {
    border-color: rgb(255 122 26 / 0.55);
  }

  /* Secciones de la ficha: pastillas claras, la sección visible en naranja; sin barra de desplazamiento,
     con un fundido a la derecha en el móvil para que se note que hay más. */
  .tabs-row {
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
  }
  .tabs-row::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    .tabs-row {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    padding: 0.55rem 1.05rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: var(--color-text);
    transition:
      background-color 0.25s,
      border-color 0.25s,
      color 0.25s;
  }
  .tab:hover {
    border-color: rgb(255 122 26 / 0.6);
    color: #fff;
  }
  .tab[aria-current='true'] {
    border-color: var(--color-signal);
    background: rgb(255 122 26 / 0.16);
    color: #fff;
  }
  .tab[aria-current='true']::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 8px var(--color-signal);
  }
  .tab:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }
  .thumb[aria-pressed='true'] {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 2px var(--color-brand);
  }

  /* Vídeos oficiales: se abren en una ventana encima de la ficha (horizontal o vertical, según el vídeo). */
  .vid-card:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 4px;
    border-radius: 14px;
  }
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
  .vid-modal {
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .vid-modal::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(4px);
  }
  .vid-modal-box {
    display: grid;
    gap: 0.9rem;
    width: min(92vw, 1100px, calc((88vh - 4rem) * 16 / 9));
  }
  .vid-modal.is-short .vid-modal-box {
    width: min(92vw, calc((88vh - 4rem) * 9 / 16));
  }
  .vid-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #000;
  }
  .vid-modal.is-short .vid-frame {
    aspect-ratio: 9 / 16;
  }
  /* El iframe se crea con JS: no lleva el atributo de los estilos con ámbito. */
  .vid-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  // Vídeos oficiales: YouTube solo se carga al pulsar un vídeo y se descarga al cerrar la ventana.
  const vidModal = document.querySelector<HTMLDialogElement>('[data-video-modal]');
  if (vidModal) {
    const frame = vidModal.querySelector<HTMLElement>('[data-video-frame]')!;
    const caption = vidModal.querySelector<HTMLElement>('[data-video-title]')!;
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLButtonElement>('[data-video-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
        iframe.title = btn.dataset.title ?? 'Vídeo de FAIRINO';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        frame.replaceChildren(iframe);
        caption.textContent = btn.dataset.title ?? '';
        vidModal.classList.toggle('is-short', btn.dataset.short !== undefined);
        vidModal.showModal();
      }),
    );
    vidModal.querySelector('[data-video-close]')?.addEventListener('click', () => vidModal.close());
    // Un clic fuera del vídeo (en el fondo oscuro) también cierra.
    vidModal.addEventListener('click', (e) => {
      if (e.target === vidModal) vidModal.close();
    });
    vidModal.addEventListener('close', () => {
      frame.replaceChildren();
      opener?.focus();
    });
  }

  // Marca la sección de la ficha que se está viendo y la mantiene a la vista en la barra.
  const tabsRow = document.querySelector<HTMLElement>('[data-section-tabs]');
  if (tabsRow) {
    const tabs = [...tabsRow.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = tabs.map((t) => document.querySelector<HTMLElement>(t.hash)).filter((x): x is HTMLElement => !!x);
    const setActive = (id: string) => {
      tabs.forEach((t) => {
        const on = t.hash === '#' + id;
        t.setAttribute('aria-current', on ? 'true' : 'false');
        if (on) tabsRow.scrollTo({ left: t.offsetLeft - 16, behavior: 'smooth' });
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-140px 0px -55% 0px' },
    );
    sections.forEach((sec) => io.observe(sec));
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const slides = [...g.querySelectorAll<HTMLElement>('[data-slide]')];
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const video = g.querySelector<HTMLVideoElement>('[data-gallery-video]');
    const toggle = g.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // El vídeo se para si se elige otra foto y vuelve a arrancar al volver a él (salvo que el usuario lo pausara).
    let userPaused = reduce;
    const setPlaying = (play: boolean) => {
      if (!video) return;
      if (play) video.play().catch(() => {});
      else video.pause();
      toggle?.setAttribute('aria-label', play ? 'Pausar el vídeo' : 'Reproducir el vídeo');
      toggle?.querySelector('.i-pause')?.classList.toggle('hidden', !play);
      toggle?.querySelector('.i-play')?.classList.toggle('hidden', play);
      const label = toggle?.querySelector('[data-video-label]');
      if (label) label.textContent = play ? 'Pausa' : 'Ver vídeo';
    };
    if (video && reduce) {
      video.removeAttribute('autoplay');
      setPlaying(false);
    }
    toggle?.addEventListener('click', () => {
      userPaused = !video!.paused;
      setPlaying(video!.paused);
    });
    // YouTube: no se carga nada de YouTube hasta que se pulsa «play».
    const yt = g.querySelector<HTMLElement>('[data-yt]');
    const ytPoster = yt?.innerHTML ?? '';
    const playYouTube = () => {
      if (!yt) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${yt.dataset.yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = yt.dataset.ytTitle ?? 'Vídeo de FAIRINO';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 size-full';
      yt.replaceChildren(iframe);
    };
    const bindYouTube = () => yt?.querySelector('[data-yt-play]')?.addEventListener('click', playYouTube);
    bindYouTube();
    thumbs.forEach((t) =>
      t.addEventListener('click', () => {
        const i = Number(t.dataset.thumb);
        slides.forEach((s) => (s.hidden = Number(s.dataset.slide) !== i));
        thumbs.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.thumb) === i)));
        if (video) setPlaying(i === 0 && !userPaused);
        if (yt && i !== 0 && yt.querySelector('iframe')) {
          yt.innerHTML = ytPoster;
          bindYouTube();
        }
      }),
    );
  });
</script>

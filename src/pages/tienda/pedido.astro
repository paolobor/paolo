---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import AccountForms from '../../components/AccountForms.astro';
import { site } from '../../data/site';
import { url } from '../../lib/url';

// Como en Amazon: para comprar hay que iniciar sesión o crear una cuenta (src/scripts/account.ts). Sin Firebase
// configurado (site.accounts) el pedido funciona como antes, sin cuenta.
const accountsOn = Boolean(site.accounts.firebase) || import.meta.env.PUBLIC_FIREBASE_EMULATOR === '1';
---

<BaseLayout title="Tramitar pedido" description="Revisa tu carrito y envía tu pedido a FAIRINO España." noindex>
  <PageHero crumbs={[{ label: 'Tienda', href: 'tienda/' }, { label: 'Pedido' }]} eyebrow="Tienda" title="Tramitar pedido" compact />

  <section class="section">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[1fr_400px]">
      <div class="grid content-start gap-6">
      {
        accountsOn && (
          <>
            <p class="flex items-center gap-2 text-muted" data-order-checking>
              <Icon name="refresh-cw" size={17} class="animate-spin" />
              Comprobando tu sesión…
            </p>
            <div class="card p-6 md:p-8" data-order-gate hidden>
              <AccountForms
                title="Para comprar, inicia sesión o regístrate"
                lead="Así guardamos tus datos de facturación y entrega para la próxima vez y puedes ver tus pedidos cuando quieras. Es un minuto."
              />
            </div>
            <p class="buyer" data-order-buyer hidden>
              <Icon name="user" size={18} class="shrink-0 text-signal" />
              <span>Compras como <b class="text-white" data-order-who /></span>
              <button type="button" class="ml-auto font-semibold text-brand underline" data-order-logout>No soy yo</button>
            </p>
          </>
        )
      }
      <form class="card grid gap-6 p-6 md:p-8" data-form="order" data-order-form novalidate hidden={accountsOn}>
        <h2 class="text-2xl font-bold" style="font-stretch:112%">Datos de facturación y entrega</h2>
        <div class="form-grid">
          <div class="form-field"><label for="o-empresa">Empresa *</label><input id="o-empresa" name="empresa" required autocomplete="organization" /></div>
          <div class="form-field"><label for="o-cif">CIF / NIF *</label><input id="o-cif" name="cif" required /></div>
          <div class="form-field"><label for="o-nombre">Persona de contacto *</label><input id="o-nombre" name="nombre" required autocomplete="name" /></div>
          <div class="form-field"><label for="o-email">Correo electrónico *</label><input id="o-email" name="email" type="email" required autocomplete="email" /></div>
          <div class="form-field"><label for="o-tel">Teléfono *</label><input id="o-tel" name="telefono" type="tel" required autocomplete="tel" /></div>
          <div class="form-field"><label for="o-cp">Código postal *</label><input id="o-cp" name="codigo_postal" required autocomplete="postal-code" /></div>
          <div class="form-field sm:col-span-2"><label for="o-dir">Dirección de entrega *</label><input id="o-dir" name="direccion" required autocomplete="street-address" /></div>
          <div class="form-field"><label for="o-ciudad">Población *</label><input id="o-ciudad" name="poblacion" required autocomplete="address-level2" /></div>
          <div class="form-field"><label for="o-prov">Provincia *</label><input id="o-prov" name="provincia" required autocomplete="address-level1" /></div>
          <div class="form-field sm:col-span-2"><label for="o-notas">Observaciones</label><textarea id="o-notas" name="observaciones" rows="3" placeholder="Horario de entrega, muelle de carga, versión IP65…"></textarea></div>
        </div>
        <label class="form-check"><input type="checkbox" name="condiciones" required /><span>Acepto las <a href={url('aviso-legal/')} class="text-brand underline">condiciones de venta</a> [DATO: condiciones de venta]. *</span></label>
        <label class="form-check"><input type="checkbox" name="privacidad" required /><span>He leído la <a href={url('politica-de-privacidad/')} class="text-brand underline">política de privacidad</a>. *</span></label>
        <input type="hidden" name="subject" value="Nuevo pedido desde la tienda web" />
        <input type="hidden" name="pedido" />
        <button type="submit" class="btn btn-primary justify-self-start"><Icon name="send" size={18} />Enviar pedido</button>
        <p class="text-sm text-muted" data-form-status aria-live="polite">Recibirás la confirmación del pedido con las condiciones de pago y entrega.</p>
      </form>
      </div>

      <aside class="card grid gap-4 p-6 lg:sticky lg:top-24" aria-labelledby="sum-title">
        <h2 id="sum-title" class="text-xl font-bold" style="font-stretch:112%">Resumen</h2>
        <ul class="grid gap-3 text-sm" data-order-lines></ul>
        <dl class="grid gap-1.5 border-t border-line pt-3 font-mono text-sm">
          <div class="flex justify-between"><dt class="text-muted">Subtotal</dt><dd data-order-subtotal>—</dd></div>
          <div class="flex justify-between"><dt class="text-muted">Envío nacional</dt><dd data-order-shipping>—</dd></div>
          <div class="flex justify-between text-base text-white"><dt>Total</dt><dd data-order-total>—</dd></div>
        </dl>
        <p class="text-sm text-muted" data-order-empty hidden>Tu carrito está vacío. <a href={url('tienda/')} class="text-brand underline">Ir a la tienda</a>.</p>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <button type="button" class="text-sm font-semibold text-brand hover:underline" data-cart-open>Editar carrito</button>
          <a href={url('tienda/#productos')} class="btn btn-ghost btn-sm">
            <Icon name="arrow-left" size={16} />
            Seguir comprando
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { cartSummary, cartText, clearCart } from '../../scripts/cart';
  import { submitForm } from '../../scripts/forms';
  import { getConfig } from '../../scripts/config';

  const lines = document.querySelector<HTMLUListElement>('[data-order-lines]');
  const render = () => {
    const s = cartSummary();
    if (!lines) return;
    lines.innerHTML = '';
    for (const r of s.rows) {
      const li = document.createElement('li');
      li.className = 'flex justify-between gap-3';
      const a = document.createElement('span');
      a.className = 'grid gap-0.5';
      a.textContent = `${r.q} × ${r.item.name}${r.version ? ` · ${r.version}` : ''}`;
      if (r.includes) {
        const inc = document.createElement('span');
        inc.className = 'text-xs leading-snug text-ok';
        inc.textContent = `✓ ${r.includes}`;
        a.append(inc);
      }
      const b = document.createElement('span');
      b.className = 'font-mono';
      b.textContent = r.unit != null ? s.fmt(r.unit * r.q) : 'Consultar';
      li.append(a, b);
      lines.append(li);
    }
    document.querySelector('[data-order-subtotal]')!.textContent = s.fmt(s.subtotal);
    document.querySelector('[data-order-shipping]')!.textContent = s.fmt(s.shipping);
    document.querySelector('[data-order-total]')!.textContent = s.fmt(s.total);
    document.querySelector<HTMLElement>('[data-order-empty]')!.hidden = s.rows.length > 0;
  };
  window.addEventListener('cart:change', render);
  render();

  const form = document.querySelector<HTMLFormElement>('[data-order-form]');

  // Cuentas de cliente: Firebase solo se descarga si están activadas.
  type Account = typeof import('../../scripts/account');
  let acc: Account | null = null;
  let user: import('../../scripts/account').User | null = null;
  const fields = ['empresa', 'cif', 'nombre', 'telefono', 'codigo_postal', 'direccion', 'poblacion', 'provincia'] as const;
  // Rellena el formulario con la ficha del cliente, sin pisar lo que ya haya escrito.
  const prefill = (p: object | null, email?: string | null) => {
    if (!form) return;
    for (const k of fields) {
      const input = form.elements.namedItem(k) as HTMLInputElement | null;
      const v = (p as Record<string, unknown> | null)?.[k];
      if (input && !input.value && typeof v === 'string' && v) input.value = v;
    }
    const mail = form.elements.namedItem('email') as HTMLInputElement | null;
    if (mail && email) mail.value = email;
  };

  if (getConfig().accounts?.firebase && form) {
    import('../../scripts/account').then((mod) => {
      acc = mod;
      const $ = (k: string) => document.querySelector<HTMLElement>(`[data-order-${k}]`)!;
      mod.onUser(async (u) => {
        user = u;
        $('checking').hidden = true;
        $('gate').hidden = Boolean(u);
        $('buyer').hidden = !u;
        form.hidden = !u;
        if (!u) return;
        $('who').textContent = u.displayName ? `${u.displayName} (${u.email})` : (u.email ?? '');
        prefill(await mod.getProfile(u).catch(() => null), u.email);
      });
      // Recién registrado: la ficha llega con el aviso del formulario de alta.
      document.addEventListener('account:registered', (e) => {
        const p = (e as CustomEvent<Record<string, string>>).detail;
        prefill(p, user?.email);
        $('who').textContent = `${p.nombre} (${p.email})`;
      });
      $('logout').addEventListener('click', () => mod.logout());
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const st = form.querySelector<HTMLElement>('[data-form-status]');
    const s = cartSummary();
    if (s.rows.length === 0) {
      if (st) st.textContent = 'Añade al menos un producto al carrito.';
      return;
    }
    const extra: Record<string, string> = { pedido: cartText() };
    if (acc && user) {
      // Se guarda en la cuenta (Mis pedidos) con la dirección para la próxima vez. Si falla, llega igual por correo.
      const data = Object.fromEntries([...new FormData(form).entries()].map(([k, v]) => [k, String(v).trim()]));
      const entrega = Object.fromEntries(fields.map((k) => [k, data[k] ?? '']));
      extra.cuenta = `${user.email} (cliente registrado)`;
      try {
        extra.referencia = await acc.saveOrder(user, {
          lineas: s.rows.map((r) => ({ id: r.id, nombre: r.item.name, version: r.version, incluye: r.includes, cantidad: r.q, precio: r.unit })),
          subtotal: s.subtotal,
          envio: s.shipping,
          total: s.total,
          pendiente: s.unpriced,
          entrega,
        });
        acc.saveProfile(user, entrega).catch(() => {});
      } catch {
        /* sin guardar en la cuenta: el correo con el pedido sale igual */
      }
    }
    const result = await submitForm(form, extra);
    if (result === 'sent') {
      clearCart();
      if (user && st) {
        st.innerHTML = '';
        const a = document.createElement('a');
        a.href = `${getConfig().base.replace(/\/$/, '')}/cuenta/#pedidos`;
        a.className = 'font-semibold text-brand underline';
        a.textContent = 'Ver mis pedidos';
        st.append('✓ Pedido recibido. Te enviaremos la confirmación con las condiciones de pago y entrega. ', a);
        st.className = 'text-sm text-ok';
      }
    }
  });
</script>

<style>
  .buyer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    border-radius: 14px;
    border: 1px solid rgb(126 226 164 / 0.35);
    background: rgb(126 226 164 / 0.07);
    padding: 0.8rem 1rem;
    font-size: 0.92rem;
  }
</style>

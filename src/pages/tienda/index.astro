---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreShowroom from '../../components/store/StoreShowroom.astro';
import StoreCard from '../../components/store/StoreCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getProducts, categoryMeta, type Product } from '../../lib/catalog';
import SmartImage from '../../components/ui/SmartImage.astro';
import IllustrativeBadge from '../../components/ui/IllustrativeBadge.astro';
import { applications } from '../../data/applications';
import { solutions } from '../../data/solutions';
import { shopCategories } from '../../data/shop';
import { isIllustrative } from '../../lib/images';
import { url } from '../../lib/url';

const products = await getProducts();

// Qué encaja con cada producto, según la compatibilidad real y las aplicaciones de cada uno.
type Rec = { id: string; reason: string };
const appName = (slug: string) => applications.find((a) => a.slug === slug)?.name ?? slug;
const shared = (a: Product, b: Product) => a.data.applications.filter((x) => b.data.applications.includes(x));
const relations: Record<string, { groups: { title: string; note?: string; items: Rec[] }[] }> = {};
for (const p of products) {
  const d = p.data;
  const groups: { title: string; note?: string; items: Rec[] }[] = [];
  if (d.category === 'cobot') {
    groups.push({
      title: 'Controlador',
      note: 'Imprescindible: elige uno (red AC o continua DC).',
      items: products
        .filter((x) => x.data.category === 'controlador' && d.compatibleWith.includes(x.id))
        .map((x) => ({ id: x.id, reason: x.data.group === 'dc' ? 'Corriente continua' : 'Corriente alterna' })),
    });
    const accs = products
      .filter((x) => x.data.category === 'accesorio' && x.data.compatibleWith.includes(p.id))
      .map((x) => ({ x, common: shared(p, x) }))
      .sort((a, b) => b.common.length - a.common.length || a.x.data.order - b.x.data.order);
    groups.push({
      title: 'Accesorios recomendados',
      note: `Según las aplicaciones del ${d.name}.`,
      items: accs.map(({ x, common }) => ({
        id: x.id,
        reason: common.length ? `Para ${common.map(appName).join(' y ').toLowerCase()}` : 'Compatible',
      })),
    });
  } else if (d.category === 'controlador') {
    groups.push({
      title: 'Cobots compatibles',
      items: products.filter((x) => d.compatibleWith.includes(x.id)).map((x) => ({ id: x.id, reason: `${x.data.payloadKg ?? '—'} kg · ${x.data.reachMm ?? '—'} mm` })),
    });
  } else {
    groups.push({
      title: 'Cobots compatibles',
      items: products
        .filter((x) => x.data.category === 'cobot' && d.compatibleWith.includes(x.id))
        .map((x) => ({ x, common: shared(p, x) }))
        .sort((a, b) => b.common.length - a.common.length || a.x.data.order - b.x.data.order)
        .map(({ x, common }) => ({ id: x.id, reason: common.length ? `Ideal para ${common.map(appName).join(' y ').toLowerCase()}` : `${x.data.payloadKg ?? '—'} kg` })),
    });
    const others = products.filter((x) => x.data.category === 'accesorio' && x.id !== p.id && shared(p, x).length > 0);
    if (others.length)
      groups.push({ title: 'Combina bien con', items: others.map((x) => ({ id: x.id, reason: `También para ${shared(p, x).map(appName).join(' y ').toLowerCase()}` })) });
  }
  relations[p.id] = { groups: groups.filter((g) => g.items.length) };
}
// Pestañas: cobots y controladores por categoría; los accesorios, por tipo de producto (src/data/shop.ts).
const catsOf = (p: Product) => [p.data.category, ...p.data.shopCategories];
const countIn = (key: string) => products.filter((p) => catsOf(p).includes(key)).length + (key === 'soluciones' ? solutions.length : 0);
const tabs = [
  { key: 'todos', label: 'Todos', count: products.length + solutions.length },
  { key: 'cobot', label: categoryMeta.cobot.label, count: countIn('cobot') },
  { key: 'controlador', label: categoryMeta.controlador.label, count: countIn('controlador') },
  ...shopCategories.map((c) => ({ key: c.key, label: c.label, count: countIn(c.key) })),
];
const emptyCats = shopCategories.filter((c) => countIn(c.key) === 0);
---

<BaseLayout
  title="Tienda de cobots FAIRINO"
  description="Compra cobots FAIRINO, controladores y accesorios oficiales en la tienda de FAIRINO España, distribuidor oficial. FR3, FR5, FR5WML, FR10, FR16, FR20, FR30 y más."
  overlayHeader
>
  <StoreShowroom />

  <script type="application/json" id="shop-relations" set:html={JSON.stringify(relations)} />
  <section id="productos" class="section scroll-mt-20" aria-labelledby="all-title" data-shop>
    <div class="container-x grid gap-8">
      <div class="grid gap-5">
        <div class="grid gap-3">
          <p class="eyebrow">Tienda</p>
          <h2 id="all-title" class="h-section">Todos los productos</h2>
        </div>
        <div class="shop-tabs -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:overflow-visible md:px-0" role="tablist" aria-label="Filtrar por tipo de producto">
          {
            tabs.map((t, i) => (
              <button type="button" role="tab" class="shop-tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.key}>
                {t.label}
                <span class="font-mono text-xs opacity-70">{t.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="grid items-start gap-6 lg:grid-cols-[340px_minmax(0,1fr)] lg:gap-8">
        <!-- Lo que encaja con el producto elegido -->
        <aside class="reco card lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto" aria-live="polite" aria-label="Productos que encajan con tu elección" data-reco>
          <div class="grid gap-3 p-6" data-reco-empty>
            <span class="grid size-11 place-items-center rounded-xl bg-signal/10 text-signal"><Icon name="layers" size={22} /></span>
            <p class="font-display text-lg font-bold" style="font-stretch:112%">Elige un producto</p>
            <p class="text-sm text-muted">
              Pulsa la imagen de cualquier producto y aquí te mostramos lo que encaja con él: controlador, accesorios o cobots compatibles. Marca lo que necesites y añádelo todo al carrito.
            </p>
          </div>
          <div class="grid gap-5 p-5" data-reco-body hidden></div>
        </aside>

        <ul class="grid grid-cols-2 gap-4 md:grid-cols-3" data-shop-grid>
          {
            products.map((p) => (
              <li data-cats={catsOf(p).join(' ')}>
                <StoreCard product={p} selectable />
              </li>
            ))
          }
          {
            solutions.map((sol) => (
              <li data-cats="soluciones">
                <article class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface transition-[border-color] hover:border-signal/40">
                  <a href={url(`soluciones-llave-en-mano/#${sol.slug}`)} class="relative block aspect-square overflow-hidden" tabindex="-1" aria-hidden="true">
                    <SmartImage src={sol.image} alt="" hint={sol.imageHint} tone="dark" position={sol.imagePosition} widths={[320, 480, 640]} sizes="(min-width: 1024px) 25vw, 50vw" class="transition-transform duration-500 group-hover:scale-105" />
                    {sol.image && isIllustrative(sol.image) && <IllustrativeBadge class="bottom-2 right-2 text-[0.5rem]!" />}
                  </a>
                  <div class="flex flex-1 flex-col gap-2 p-5">
                    <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-mist">Llave en mano</p>
                    <h3 class="font-display text-lg font-bold leading-tight" style="font-stretch:112%">
                      <a href={url(`soluciones-llave-en-mano/#${sol.slug}`)} class="hover:text-signal">{sol.name}</a>
                    </h3>
                    <p class="text-sm text-muted">{sol.summary}</p>
                    <div class="mt-auto flex items-center justify-between gap-3 pt-3">
                      <span class="font-mono text-lg">A medida</span>
                      <a href={url(`contacto/?asunto=presupuesto&producto=${encodeURIComponent(sol.name)}`)} class="btn btn-primary btn-sm">Pedir propuesta</a>
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
          {
            emptyCats.map((c) => (
              <li data-cats={c.key} data-only hidden class="col-span-2 md:col-span-3">
                <div class="card flex flex-col items-start gap-4 p-6 md:flex-row md:items-center md:justify-between">
                  <div class="grid gap-1">
                    <p class="font-display text-lg font-bold" style="font-stretch:112%">{c.label}: bajo pedido</p>
                    <p class="text-sm text-muted">Todavía no hay referencias publicadas. Cuéntanos qué necesitas y te preparamos opciones de {c.empty} compatibles con tu cobot.</p>
                  </div>
                  <a href={url(`contacto/?asunto=presupuesto&producto=${encodeURIComponent(c.label)}`)} class="btn btn-primary btn-sm shrink-0">Consultar</a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="blueprint on-dark border-t border-line">
    <div class="container-x grid items-center gap-6 py-14 md:grid-cols-[1fr_auto]">
      <div class="grid gap-3">
        <p class="eyebrow">¿Una célula completa?</p>
        <h2 class="h-section max-w-[24ch]">Combina cobot, controlador y accesorios en el configurador</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={url('configurador/')} class="btn btn-primary"><Icon name="sliders-horizontal" size={18} />Configurar mi célula</a>
        <a href={url('reservar-cita/')} class="btn btn-ghost">Pedir asesoramiento</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-tabs {
    scrollbar-width: none;
  }
  .shop-tab {
    flex-shrink: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s;
  }
  .shop-tab:hover {
    border-color: var(--color-signal);
  }
  .shop-tab[aria-selected='true'] {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: var(--color-ink);
  }
</style>

<script>
  import { addToCart, storeData } from '../../scripts/cart';

  type Rec = { id: string; reason: string };
  const shop = document.querySelector<HTMLElement>('[data-shop]');
  if (shop) {
    const tabs = [...shop.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const items = [...shop.querySelectorAll<HTMLElement>('[data-cats]')];
    const reco = shop.querySelector<HTMLElement>('[data-reco]')!;
    const empty = reco.querySelector<HTMLElement>('[data-reco-empty]')!;
    const body = reco.querySelector<HTMLElement>('[data-reco-body]')!;
    const relations: Record<string, { groups: { title: string; note?: string; items: Rec[] }[] }> = JSON.parse(
      document.getElementById('shop-relations')?.textContent || '{}',
    );
    const data = storeData();
    const fmt = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const price = (id: string) => (data[id]?.price != null ? fmt.format(data[id].price!) : 'Consultar');

    const filter = (key: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === key)));
      // «Todos» no muestra las tarjetas de consulta de las categorías vacías (data-only).
      items.forEach((it) => (it.hidden = key === 'todos' ? 'only' in it.dataset : !it.dataset.cats!.split(' ').includes(key)));
    };
    tabs.forEach((t) => t.addEventListener('click', () => filter(t.dataset.tab!)));

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const thumb = (id: string, size = 'size-12') => {
      const box = el('span', `grid ${size} shrink-0 place-items-center overflow-hidden rounded-lg border border-line bg-surface-2`);
      if (data[id]?.img) {
        const img = el('img', 'size-full object-contain p-1') as HTMLImageElement;
        img.src = data[id].img!;
        img.alt = '';
        box.append(img);
      }
      return box;
    };

    const updateButton = () => {
      const n = body.querySelectorAll('input[data-reco-pick]:checked').length + 1;
      const btn = body.querySelector<HTMLButtonElement>('[data-reco-add]');
      if (btn) btn.textContent = n > 1 ? `Añadir ${n} productos al carrito` : 'Añadir al carrito';
    };

    const select = (id: string) => {
      const it = data[id];
      if (!it) return;
      shop.querySelectorAll('[data-card]').forEach((c) => c.toggleAttribute('data-selected', (c as HTMLElement).dataset.card === id));
      empty.hidden = true;
      body.hidden = false;
      body.innerHTML = '';

      // Producto elegido
      const head = el('div', 'flex items-center gap-3');
      head.append(thumb(id, 'size-16'));
      const ht = el('div', 'grid min-w-0');
      ht.append(el('span', 'font-mono text-[0.62rem] uppercase tracking-[0.14em] text-signal', 'Has elegido'));
      ht.append(el('span', 'font-display text-xl font-bold leading-tight', it.name));
      ht.append(el('span', 'font-mono text-sm text-mist', price(id)));
      head.append(ht);
      const close = el('button', 'ml-auto grid size-8 shrink-0 place-items-center rounded-full border border-line text-mist hover:border-signal hover:text-signal', '×');
      close.setAttribute('aria-label', 'Quitar selección');
      close.addEventListener('click', () => {
        shop.querySelectorAll('[data-card]').forEach((c) => c.removeAttribute('data-selected'));
        body.hidden = true;
        empty.hidden = false;
      });
      head.append(close);
      body.append(head);

      // Grupos recomendados
      for (const g of relations[id]?.groups ?? []) {
        const sec = el('section', 'grid gap-2 border-t border-line pt-4');
        sec.append(el('h3', 'font-display text-base font-bold', g.title));
        if (g.note) sec.append(el('p', 'text-xs text-muted', g.note));
        const ul = el('ul', 'grid gap-1.5');
        for (const r of g.items) {
          if (!data[r.id]) continue;
          const li = el('li');
          const label = el('label', 'flex cursor-pointer items-center gap-3 rounded-xl border border-transparent p-2 transition-colors hover:border-line hover:bg-surface-2');
          const cb = el('input', 'size-4 shrink-0 accent-[var(--color-signal)]') as HTMLInputElement;
          cb.type = 'checkbox';
          cb.dataset.recoPick = r.id;
          cb.addEventListener('change', updateButton);
          label.append(cb, thumb(r.id, 'size-10'));
          const t = el('span', 'grid min-w-0 flex-1');
          t.append(el('span', 'truncate text-sm font-semibold', data[r.id].name));
          t.append(el('span', 'truncate text-xs text-muted', r.reason));
          label.append(t, el('span', 'shrink-0 font-mono text-xs text-mist', price(r.id)));
          li.append(label);
          ul.append(li);
        }
        sec.append(ul);
        body.append(sec);
      }

      // Acciones
      const actions = el('div', 'grid gap-2 border-t border-line pt-4');
      const add = el('button', 'btn btn-primary w-full', 'Añadir al carrito') as HTMLButtonElement;
      add.type = 'button';
      add.dataset.recoAdd = '';
      add.addEventListener('click', () => {
        addToCart(id);
        body.querySelectorAll<HTMLInputElement>('input[data-reco-pick]:checked').forEach((c) => addToCart(c.dataset.recoPick!));
        document.querySelector<HTMLElement>('[data-cart-open]')?.click();
      });
      const link = el('a', 'text-center text-sm font-semibold text-brand hover:underline', 'Ver ficha completa') as HTMLAnchorElement;
      link.href = it.href;
      actions.append(add, link);
      body.append(actions);
      updateButton();

      // En móvil el panel está encima: lo traemos a la vista.
      if (window.matchMedia('(max-width: 1023px)').matches) reco.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    shop.querySelectorAll<HTMLElement>('[data-select]').forEach((b) => b.addEventListener('click', () => select(b.dataset.select!)));
  }
</script>

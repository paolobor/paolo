---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreShowroom from '../../components/store/StoreShowroom.astro';
import StoreCard from '../../components/store/StoreCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getProducts, categoryMeta } from '../../lib/catalog';
import { url } from '../../lib/url';

const products = await getProducts();
const tabs = [
  { key: 'todos', label: 'Todos', count: products.length },
  ...(['cobot', 'controlador', 'accesorio'] as const).map((c) => ({
    key: c,
    label: categoryMeta[c].label,
    count: products.filter((p) => p.data.category === c).length,
  })),
];
---

<BaseLayout
  title="Tienda de cobots FAIRINO"
  description="Compra cobots FAIRINO, controladores y accesorios oficiales en la tienda de FAIRINO España, distribuidor oficial. FR3, FR5, FR5WML, FR10, FR16, FR20, FR30 y más."
  overlayHeader
>
  <StoreShowroom />

  <section id="productos" class="section scroll-mt-20" aria-labelledby="all-title" data-shop>
    <div class="container-x grid gap-8">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div class="grid gap-3">
          <p class="eyebrow">Tienda</p>
          <h2 id="all-title" class="h-section">Todos los productos</h2>
        </div>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filtrar por categoría">
          {
            tabs.map((t, i) => (
              <button type="button" role="tab" class="shop-tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.key}>
                {t.label}
                <span class="font-mono text-xs opacity-70">{t.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <ul class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4" data-shop-grid>
        {
          products.map((p) => (
            <li data-cat={p.data.category}>
              <StoreCard product={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="blueprint on-dark border-t border-line">
    <div class="container-x grid items-center gap-6 py-14 md:grid-cols-[1fr_auto]">
      <div class="grid gap-3">
        <p class="eyebrow">¿Una célula completa?</p>
        <h2 class="h-section max-w-[24ch]">Combina cobot, controlador y accesorios en el configurador</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={url('configurador/')} class="btn btn-primary"><Icon name="sliders-horizontal" size={18} />Configurar mi célula</a>
        <a href={url('reservar-cita/')} class="btn btn-ghost">Pedir asesoramiento</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s;
  }
  .shop-tab:hover {
    border-color: var(--color-signal);
  }
  .shop-tab[aria-selected='true'] {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: var(--color-ink);
  }
</style>

<script>
  const shop = document.querySelector<HTMLElement>('[data-shop]');
  if (shop) {
    const tabs = [...shop.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const items = [...shop.querySelectorAll<HTMLElement>('[data-cat]')];
    const select = (key: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === key)));
      items.forEach((it) => (it.hidden = key !== 'todos' && it.dataset.cat !== key));
    };
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.tab!)));
  }
</script>

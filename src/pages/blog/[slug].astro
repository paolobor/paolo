---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import SmartImage from '../../components/ui/SmartImage.astro';
import IllustrativeBadge from '../../components/ui/IllustrativeBadge.astro';
import ContactBand from '../../components/home/ContactBand.astro';
import { site } from '../../data/site';
import { findImage, isIllustrative } from '../../lib/images';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const df = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const others = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const cover = findImage(d.cover);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  inLanguage: 'es-ES',
  mainEntityOfPage: new URL(url(`blog/${post.id}/`), Astro.site).toString(),
  ...(cover ? { image: new URL(cover.src, Astro.site).toString() } : {}),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
---

<BaseLayout title={d.title} description={d.description} jsonLd={[articleSchema]}>
  <section class="blueprint on-dark text-white">
    <div class="container-x grid max-w-4xl gap-5 py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Blog', href: 'blog/' }, { label: d.title }]} />
      <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.12em] text-mist">
        <span class="text-brand-hi">{d.category}</span>
        <time datetime={d.date.toISOString()}>{df.format(d.date)}</time>
      </p>
      <h1 class="text-[clamp(2rem,4.4vw,3.2rem)] font-extrabold" style="font-stretch:115%">{d.title}</h1>
      <p class="lead">{d.description}</p>
    </div>
  </section>

  <article class="section pt-10">
    <div class="container-x grid max-w-4xl gap-10">
      <div class="relative aspect-[16/9] overflow-hidden rounded-[var(--radius-card)] border border-line">
        <SmartImage src={d.cover} alt={d.coverAlt} hint={d.coverAlt} tone="dark" widths={[640, 960, 1400]} sizes="(min-width: 960px) 56rem, 100vw" eager />
        {isIllustrative(d.cover) && <IllustrativeBadge />}
      </div>
      <div class="prose-fairino">
        <Content />
      </div>
      <aside class="card flex flex-col items-start gap-4 p-6 md:flex-row md:items-center md:justify-between">
        <div class="grid gap-1">
          <p class="font-display text-xl font-bold" style="font-stretch:115%">¿Lo vemos con tu caso?</p>
          <p class="text-muted">Cuéntanos tu aplicación y te recomendamos modelo y equipamiento.</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <a href={url('contacto/')} class="btn btn-primary btn-sm">Contactar</a>
          <a href={url('configurador/')} class="btn btn-secondary btn-sm">Configurador</a>
        </div>
      </aside>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section bg-paper" aria-labelledby="more-posts">
        <div class="container-x max-w-4xl">
          <h2 id="more-posts" class="font-display text-2xl font-bold" style="font-stretch:115%">Sigue leyendo</h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-2">
            {others.map((p) => (
              <li>
                <a href={url(`blog/${p.id}/`)} class="card card-hover group grid h-full content-start gap-2 p-6">
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-brand">{p.data.category}</span>
                  <span class="font-bold leading-snug group-hover:text-brand">{p.data.title}</span>
                  <span class="link-arrow pt-1 text-sm">Leer <Icon name="arrow-right" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactBand />
</BaseLayout>

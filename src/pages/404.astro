---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o ha cambiado de dirección." noindex>
  <section class="blueprint on-dark text-white">
    <div class="container-x grid min-h-[60vh] content-center gap-6 py-24">
      <p class="eyebrow">Error 404</p>
      <h1 class="h-section max-w-[18ch] text-[clamp(2.2rem,5vw,3.5rem)]">Esta página se ha salido de su trayectoria</h1>
      <p class="lead">Puede que el enlace haya cambiado con la nueva web. Vuelve al inicio o escríbenos y te ayudamos.</p>
      <div class="flex flex-wrap gap-3">
        <a href={url('/')} class="btn btn-light">Ir al inicio</a>
        <a href={url('contacto/')} class="btn btn-ghost">Contactar</a>
      </div>
    </div>
  </section>
</BaseLayout>
